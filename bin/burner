def _setup_step_status(step):
    """Return 'done', 'pending', or 'unknown' for a step."""
    try:
        live = step["check"]()
    except Exception:
        live = None
    if live is True:
        return "done"
    if live is False:
        return "pending"
    st = _setup_state_load()
    if step["name"] in st["done"]:
        return "done"
    return "unknown"


def _setup_print_human(step):
    print("HUMAN STEP: {}".format(step["title"]))
    print(step["instruction"])
    print("When done, tell the agent; it records with: "
          "burner setup --step {} --confirm".format(step["name"]))


def _setup_ask(prompt, auto_yes):
    if auto_yes:
        return True
    try:
        ans = input(prompt + " [y/n] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return ans in ("y", "yes")


def cmd_setup(args):
    steps = {s["name"]: s for s in SETUP_STEPS}

    if args.list_steps:
        for s in SETUP_STEPS:
            print("{:24s} {:6s} {}".format(
                s["name"], s["kind"], _setup_step_status(s)))
        return 0

    if args.step:
        s = steps.get(args.step)
        if not s:
            print("unknown step: {}. Use --list-steps.".format(args.step),
                  file=sys.stderr)
            return 1
        if args.confirm:
            _setup_state_save(s["name"])
            print("recorded '{}' as done.".format(s["name"]))
            return 0
        status = _setup_step_status(s)
        if status == "done":
            print("step '{}' already done.".format(s["name"]))
            return 0
        if s["kind"] == "human":
            _setup_print_human(s)
            return 0
        rc = s["run"](args)
        if rc == 0 and _setup_step_status(s) == "done":
            _setup_state_save(s["name"])
        return rc

    # Full interactive run.
    for s in SETUP_STEPS:
        status = _setup_step_status(s)
        print("--- {} [{}]".format(s["name"], status))
        if status == "done":
            continue
        if s["kind"] == "human":
            _setup_print_human(s)
            if args.yes:
                print("(waiting on the human; continuing to agent steps)")
                continue
            try:
                ans = input("done, skip, or quit? [done/skip/quit] "
                            ).strip().lower()
            except (EOFError, KeyboardInterrupt):
                print()
                return 1
            if ans == "done":
                _setup_state_save(s["name"])
            elif ans == "quit":
                return 1
            continue
        if not _setup_ask("run '{}'?".format(s["title"]), args.yes):
            print("skipped.")
            continue
        rc = s["run"](args)
        if rc != 0:
            print("step '{}' failed; fix it and re-run.".format(s["name"]),
                  file=sys.stderr)
            return rc
        if _setup_step_status(s) == "done":
            _setup_state_save(s["name"])
    print("setup complete.")
    return 0


INSTALL_URL = "https://useburner.si/install.sh"


TARBALL_URL = "https://github.com/useburner/burner/archive/refs/heads/master.tar.gz"


def _update_recipes():
    """Refresh only the built-in recipes from the latest burner release.
    Recipes you recorded under your own names are left alone."""
    import io
    import tarfile
    try:
        blob = _setup_urlopen(TARBALL_URL, timeout=120)
    except Exception as e:
        print("could not download the latest recipes: {}".format(e),
              file=sys.stderr)
        return 1
    dest = os.path.join(ROOT, "recipes")
    os.makedirs(dest, exist_ok=True)
    names = []
    with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as tf:
        for m in tf.getmembers():
            parts = m.name.split("/")
            if (m.isfile() and len(parts) == 3 and parts[1] == "recipes"
                    and parts[2].endswith(".burner")):
                with open(os.path.join(dest, parts[2]), "wb") as f:
                    f.write(tf.extractfile(m).read())
                names.append(parts[2][:-len(".burner")])
    if not names:
        print("no recipes found in the latest release.", file=sys.stderr)
        return 1
    print("recipes updated: {}".format(", ".join(sorted(names))))
    return 0


def cmd_update(args):
    """Re-run the web installer over this install. Keeps config.env, the
    phone pairing and your own recorded recipes; built-in recipes and burner
    itself are refreshed. `burner update recipes` refreshes only recipes."""
    if getattr(args, "what", None) == "recipes":
        return _update_recipes()
    env = dict(os.environ, BURNER_DIR=ROOT)
    r = subprocess.run(["bash", "-c", "curl -fsSL {} | bash".format(INSTALL_URL)],
                       env=env)
    if r.returncode != 0:
        print("update failed (see above).", file=sys.stderr)
        return r.returncode
    _stop_helper_daemons()
    return 0


def _stop_helper_daemons():
    """Stop the long-running helpers (scrcpy mux, u2 mux) so the next command
    starts them from the freshly updated code. Without this they keep
    running the old code until killed by hand."""
    import signal
    for name in ("scrcpy-mux", "u2-mux"):
        pidfile = os.path.join(ROOT, "run", name + ".pid")
        try:
            with open(pidfile) as f:
                os.kill(int(f.read().strip()), signal.SIGTERM)
        except (OSError, ValueError):
            pass  # not running
        for ext in (".pid", ".sock"):
            try:
                os.remove(os.path.join(ROOT, "run", name + ext))
            except OSError:
                pass


UNINSTALL_STEPS = [
    ("screen no longer stays on while charging",
     ["settings", "put", "global", "stay_on_while_plugged_in", "0"]),
    ("swipe lock screen back on",
     ["locksettings", "set-disabled", "false"]),
    ("Tailscale no longer set as always-on VPN",
     ["settings", "delete", "secure", "always_on_vpn_app"]),
    ("ADB Auto Enable removed", ["pm", "uninstall", SETUP_APK_PKG]),
    ("uiautomator helper app removed",
     ["pm", "uninstall", "com.github.uiautomator"]),
    ("uiautomator test app removed",
     ["pm", "uninstall", "com.github.uiautomator.test"]),
    ("uiautomator server file removed",
     ["rm", "-f", "/data/local/tmp/u2.jar"]),
    # Last: this drops our own connection to the phone.
    ("Wireless debugging turned off",
     ["settings", "put", "global", "adb_wifi_enabled", "0"]),
]


def cmd_uninstall(args):
    """Undo what burner setup changed on the phone, then forget setup state.
    Leaves Tailscale, Developer options and this computer's files alone."""
    if not args.yes:
        print("burner uninstall will, on the phone:")
        for label, _ in UNINSTALL_STEPS:
            print("  - {}".format(label))
        print("and forget this computer's setup progress. Tailscale and "
              "Developer options stay as they are. Run with --yes to do it.")
        return 0
    if _setup_device_state() != "device":
        print("phone not reachable; run `burner ensure` first.", file=sys.stderr)
        return 1
    for label, cmd in UNINSTALL_STEPS:
        try:
            r = adb("shell", *cmd, timeout=30)
            ok = r.returncode == 0
        except Exception:
            ok = cmd[-1] == "0"  # the connection drop on the last step
        print("{} {}".format("ok  " if ok else "skip", label))
    adb("disconnect", TARGET, timeout=10)
    try:
        os.remove(SETUP_STATE_PATH)
    except OSError:
        pass
    print("done. To remove burner from this computer too, delete {}".format(ROOT))
    return 0


LOCKED_COMMANDS = {"tap", "type", "press", "scroll", "start", "open", "do",
                   "recipe", "replay", "dismiss"}


def _acquire_lock(path=None, timeout=120):
    """Run one screen-changing burner command at a time per phone.

    Assistants sometimes fire several burner commands at once (two taps, or a
    tap and a swipe in parallel). They fight over the screen. Queue them
    instead. Returns the held lock file, or None when locking isn't
    available (Windows) or another burner command held it for `timeout`
    seconds (then we run anyway rather than hang). Child burner processes
    inherit BURNER_LOCK_HELD and skip the lock, so recipes can't deadlock."""
    if os.environ.get("BURNER_LOCK_HELD"):
        return None
    try:
        import fcntl
    except ImportError:
        return None
    path = path or os.path.join(ROOT, "run", "burner.lock")
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        f = open(path, "w")
    except OSError:
        return None
    deadline = time.time() + timeout
    told = False
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.environ["BURNER_LOCK_HELD"] = "1"
            return f
        except OSError:
            if time.time() >= deadline:
                f.close()
                return None
            if not told:
                print("waiting for another burner command to finish...",
                      file=sys.stderr)
                told = True
            time.sleep(0.2)


# Commands that legitimately run long or set their own time limit.
WATCHDOG_EXEMPT = {"setup", "update", "do", "recipe", "replay", "wait", "vcode",
                   "gcode", "record", "sleep", "amazon-status", "uninstall",
                   "doctor", "ensure"}


def _arm_watchdog(args):
    """Fail a stuck command instead of hanging forever: after BURNER_TIMEOUT
    seconds (default 60) print what happened and exit 124."""
    import signal
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        limit = int(os.environ.get("BURNER_TIMEOUT", "60"))
    except ValueError:
        limit = 60
    if cmd in WATCHDOG_EXEMPT or limit <= 0 or not hasattr(signal, "SIGALRM"):
        return

    def fire(signum, frame):
        print("burner {}: no result after {}s, stopped. The phone may be "
              "asleep or unreachable: run `burner ensure`, then try again."
              .format(cmd, limit), file=sys.stderr)
        os._exit(124)
    signal.signal(signal.SIGALRM, fire)
    signal.alarm(limit)


def main():
    ap = build_parser()
    args = ap.parse_args()
    # Session recording: log action commands to the active recipe file.
    # This happens before execution so the command is captured even if it fails.
    # (The record/replay commands themselves are not recorded.)
    cmd_line = record_command_line(args)
    if cmd_line:
        record_log(cmd_line)
    # Only commands that change the screen queue; reads (dump, shot, wait)
    # stay free, so a `wait` can't hold back the tap it is waiting for.
    _lock = (_acquire_lock() if sys.argv[1:2] and sys.argv[1] in
             LOCKED_COMMANDS else None)  # noqa: F841 (held until exit)
    _arm_watchdog(args)
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
