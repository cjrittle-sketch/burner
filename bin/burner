#!/usr/bin/env python3
"""burner - phone-control CLI for the dedicated Pixel 7 ("mobile").

Replaces the old dump -> inline-python -> tap -> sleep loop with one-liners:

    burner tap "Not now"                 tap the first node with that text
    burner wait "Enter code" --timeout 30
    burner type "42327079" --clear       char-by-char typing (works on Bloks/RN fields)
    burner gcode --from "security@example.com"
    burner vcode --from "security@example.com"     # full code-entry flow, one shot

Verification codes are transient: pulled, typed, never stored.
"""
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)  # the burner folder, e.g. ~/burner
# Tools (adb, older venvs) live in BURNER_WORKSPACE if set, else in this
# tree (where install.sh puts them), else in the tree's parent (older layout).
WORKSPACE = os.environ.get("BURNER_WORKSPACE") or (
    ROOT if os.path.isdir(os.path.join(ROOT, ".android-tools"))
    else os.path.dirname(ROOT))
ADB_BIN = os.path.join(WORKSPACE, ".android-tools", "platform-tools", "adb")


def load_config():
    cfg = {}
    try:
        with open(os.path.join(ROOT, "config.env")) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip().strip('"')
    except FileNotFoundError:
        pass
    return cfg


CFG = load_config()
TARGET = "127.0.0.1:{}".format(CFG.get("LOCAL_PORT", "15555"))
UI_PATH = "/sdcard/burner-ui.xml"
SNAP_DIR = os.path.join(os.path.expanduser("~"), ".cache", "burner")
SNAP_PATH = os.path.join(SNAP_DIR, "snap.json")
SNAP_TTL = 120  # seconds: @eN handles expire after this (belt and braces;
                # any mutating action already deletes the snap file)


def snap_invalidate():
    """Drop the saved snap handles (called on every screen-changing action)."""
    try:
        if os.path.exists(SNAP_PATH):
            os.remove(SNAP_PATH)
    except OSError:
        pass


def adb(*args, timeout=30):
    return subprocess.run(
        [ADB_BIN, "-s", TARGET] + [str(a) for a in args],
        capture_output=True, text=True, timeout=timeout)


def ensure(heal_fast_paths=True):
    """Make sure the tunnel is up and adb is connected. Returns True if usable.
    heal_fast_paths=False skips restarting the scrcpy/u2 helpers (up to ~45s),
    for plain adb commands that don't use them."""
    subprocess.run([os.path.join(ROOT, "tunnel.sh"), "start"],
                   capture_output=True, timeout=45)
    adb("connect", TARGET)
    r = adb("get-state")
    if r.stdout.strip() != "device":
        # adb daemon itself can wedge (stale server) — restart it once.
        adb("kill-server")
        time.sleep(2)
        adb("start-server")
        adb("connect", TARGET)
        time.sleep(1)
        r = adb("get-state")
    ok = r.stdout.strip() == "device"
    if not ok:
        print("phone not reachable (state: {}). Check wireless debugging + Tailscale.".format(
            r.stdout.strip() or "none"), file=sys.stderr)
    if not heal_fast_paths:
        return ok
    # Heal the fast paths too (best effort — legacy adb still works without them).
    try:
        scrcpy_send("ping")
    except Exception as e:
        print("scrcpy mux heal failed: {}".format(e), file=sys.stderr)
    try:
        u2ctl("health", timeout=45)
    except Exception as e:
        print("u2 mux heal failed: {}".format(e), file=sys.stderr)
    return ok


def adb_or_ensure(*args, **kwargs):
    r = adb(*args, **kwargs)
    err = (r.stderr or "")
    if ("device offline" in err or "no devices" in err
            or "not found" in err or "no device" in err.lower()):
        # Only adb is needed here; the UI helpers heal themselves on use.
        if ensure(heal_fast_paths=False):
            r = adb(*args, **kwargs)
    return r


# ---------------------------------------------------------------- fast paths
# scrcpy persistent input channel + uiautomator2 persistent UI reads.
# Both auto-start their mux daemons; every call falls back to legacy adb.

SCRCPY_DIR = os.path.join(ROOT, "lib", "scrcpy")
U2CTL = os.path.join(ROOT, "bin", "u2ctl")
_scrcpy_send = None
_screen_wh = "1080 2400"  # updated from each dump's rotation attribute


def _update_screen_from_dump(root):
    global _screen_wh
    try:
        rot = int(root.attrib.get("rotation", "0") or 0)
    except ValueError:
        rot = 0
    _screen_wh = "2400 1080" if rot in (1, 3) else "1080 2400"
    # Better than assuming a phone model: the biggest node bounds in the dump
    # are the real screen size at the current rotation.
    w = h = 0
    for n in root.iter("node"):
        m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", n.attrib.get("bounds", ""))
        if m:
            w, h = max(w, int(m.group(3))), max(h, int(m.group(4)))
    if w >= 300 and h >= 300:
        _screen_wh = "{} {}".format(w, h)


def dump_package(root):
    """Package of the app on screen (ignoring the status bar), or None."""
    counts = {}
    for n in root.iter("node"):
        pkg = n.attrib.get("package", "")
        if pkg and pkg != "com.android.systemui":
            counts[pkg] = counts.get(pkg, 0) + 1
    return max(counts, key=counts.get) if counts else None


def scrcpy_send(line):
    """Send a command to the scrcpy mux (persistent input channel)."""
    global _scrcpy_send
    if os.environ.get("BURNER_SCRCPY") == "0":
        # Test copies must not spawn a second scrcpy mux next to live's.
        raise RuntimeError("scrcpy disabled (BURNER_SCRCPY=0)")
    if _scrcpy_send is None:
        sys.path.insert(0, SCRCPY_DIR)
        from scrcpy_ctl import _mux_send
        _scrcpy_send = _mux_send
    for attempt in range(2):
        try:
            reply = _scrcpy_send(line)
            if reply == "ok":
                return True
            raise RuntimeError("mux replied: {}".format(reply))
        except Exception as e:
            if attempt == 0:
                time.sleep(2)  # mux may be mid-recovery; retry once
            else:
                raise
    return False


def scrcpy_available():
    try:
        return scrcpy_send("ping")
    except Exception as e:
        print("scrcpy fast path unavailable: {}".format(e), file=sys.stderr)
        return False


def u2ctl(*args, timeout=30):
    """Run u2ctl; returns stdout or None on failure."""
    try:
        r = subprocess.run([U2CTL] + list(args), capture_output=True,
                           text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


U2_SOCK = os.path.join(ROOT, "run", "u2-mux.sock")
U2_NOT_FOUND = "__NOT_FOUND__"


def u2sock(cmd, arg="", timeout=30):
    """Talk to the u2 mux daemon directly over its Unix socket.

    Protocol (see u2mux.py): send "cmd arg\\n", read "ok <nbytes>\\n" +
    <nbytes> payload. Saves ~50-100ms vs spawning u2ctl per call.
    Returns payload str, None on transport failure, or U2_NOT_FOUND
    sentinel when the daemon reports an expected miss."""
    import socket
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(timeout)
        s.connect(U2_SOCK)
        s.sendall(("{} {}\n".format(cmd, arg)).encode())
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(64)
            if not chunk:
                return None
            buf += chunk
        head, rest = buf.split(b"\n", 1)
        parts = head.decode().strip().split(" ", 1)
        if len(parts) != 2 or parts[0] != "ok":
            return None
        n = int(parts[1])
        payload = rest
        while len(payload) < n:
            chunk = s.recv(min(65536, n - len(payload)))
            if not chunk:
                return None
            payload += chunk
        return payload.decode()
    except Exception:
        return None
    finally:
        try:
            s.close()
        except Exception:
            pass


def u2_invalidate():
    """Tell the u2 mux the screen changed (drops its 2s dump cache)."""
    u2sock("invalidate", timeout=5)
    snap_invalidate()  # @eN handles from burner snap are now stale


def fast_dump():
    """UI hierarchy XML via uiautomator2 mux. None on failure."""
    xml = u2sock("dump", timeout=40)
    if xml and ("<hierarchy" in xml or "<?xml" in xml):
        try:
            root = ET.fromstring(xml)
            _update_screen_from_dump(root)
            return root
        except ET.ParseError:
            pass
    return None


# ---------------------------------------------------------------- UI tree

def ui_dump(retries=4):
    """Dump the UI hierarchy, retrying through app transitions/empty dumps.
    Fast path: uiautomator2 persistent server (~1s). Fallback: adb shell."""
    root = fast_dump()
    if root is not None:
        return root
    wake()  # screen timeout is 10s; dumps come back empty when asleep
    time.sleep(1)
    last = ""
    for _ in range(retries):
        adb_or_ensure("shell", "uiautomator", "dump", UI_PATH)
        r = adb_or_ensure("shell", "cat", UI_PATH)
        last = (r.stdout or "").strip()
        if last.startswith("<?xml") or last.startswith("<hierarchy"):
            try:
                return ET.fromstring(r.stdout)
            except ET.ParseError:
                pass
        time.sleep(2)
    raise RuntimeError("uiautomator dump kept coming back empty: {!r}".format(last[:80]))


def walk(root):
    """Yield dicts for every node, with parent chain attached."""
    out = []

    def rec(node, parents):
        b = node.attrib.get("bounds", "")
        m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", b or "")
        cx = cy = None
        if m:
            x1, y1, x2, y2 = map(int, m.groups())
            cx, cy = (x1 + x2) // 2, (y1 + y2) // 2
        out.append({
            "text": node.attrib.get("text", ""),
            "desc": node.attrib.get("content-desc", ""),
            "rid": node.attrib.get("resource-id", ""),
            "class": node.attrib.get("class", ""),
            "bounds": b,
            "center": (cx, cy),
            "clickable": node.attrib.get("clickable") == "true",
            "enabled": node.attrib.get("enabled") != "false",
            "focused": node.attrib.get("focused") == "true",
            "checked": node.attrib.get("checked") == "true",
            "parents": list(parents),
        })
        for ch in node:
            rec(ch, parents + [node])

    rec(root, [])
    return out


def clickable_target(node):
    """Return center of the node or its nearest clickable ancestor."""
    if node["clickable"] and node["center"][0] is not None:
        return node["center"]
    for p in reversed(node["parents"]):
        if p.attrib.get("clickable") == "true":
            m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", p.attrib.get("bounds", "") or "")
            if m:
                x1, y1, x2, y2 = map(int, m.groups())
                return ((x1 + x2) // 2, (y1 + y2) // 2)
    return node["center"]


def find_nodes(nodes, text, exact=True):
    def label(n):
        return n["text"] or n["desc"] or ""
    if exact:
        return [n for n in nodes if label(n) == text]
    tl = text.lower()
    return [n for n in nodes if tl in label(n).lower()]


def as_json(args):
    """True when --json output was requested (flag lives on the top-level
    parser and on the dump/tap/wait/state/doctor subparsers)."""
    return bool(getattr(args, "json", False))


# ------------------------------------------------- occlusion + geometry

def _bounds_rect(bounds):
    """Parse a '[x1,y1][x2,y2]' bounds string into (x1, y1, x2, y2), or None."""
    m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", bounds or "")
    return tuple(map(int, m.groups())) if m else None


def _is_blocker(cover, target):
    """True if `cover`, drawn after the tap target and covering its tap
    point, would really steal the tap.

    Most "covers" are harmless. Play Store's Install button is a text node
    with an unlabeled Button drawn after it, which is the real tap surface;
    Compose apps and web pages draw tabs, buttons and page content as
    unlabeled Views. Refusing those made assistants waste minutes per tap.
    Only these block: a dialog, sheet, popup or menu; something with its
    own label (text or description) drawn on top; and a big clickable
    unlabeled scrim that dims the screen behind a modal.
    Pure function: no adb, unit-testable."""
    cls = (cover.get("class") or "").lower()
    if any(k in cls for k in _OVERLAY_CLASS_HINTS):
        return True
    cover_label = (cover.get("text") or cover.get("desc") or "").strip()
    if cover_label:
        # The same control twice: a ViewGroup described "Close" around or
        # beside a "Close" icon is the button itself, not something on top.
        target_label = ((target or {}).get("text")
                        or (target or {}).get("desc") or "").strip()
        return cover_label.lower() != target_label.lower()
    cr = _bounds_rect(cover.get("bounds"))
    if not cr:
        return False
    w, h = screen_dims()
    area = max(0, cr[2] - cr[0]) * max(0, cr[3] - cr[1])
    return bool(cover.get("clickable")) and area >= 0.4 * w * h


def is_point_covered(nodes, x, y, exclude_node):
    """Return the topmost node covering point (x, y), or None if uncovered.

    "Topmost" = latest in document order (walk() order: parents before
    children, siblings in order — later nodes paint on top). exclude_node is
    skipped (the tap target itself); pass None to check every node. With a
    target, only covers that would really steal the tap count (_is_blocker).
    Pure function: no adb, unit-testable."""
    idx = -1
    if exclude_node is not None:
        for i, n in enumerate(nodes):
            if n is exclude_node:
                idx = i
                break
    cover = None
    for n in nodes[idx + 1:]:
        r = _bounds_rect(n.get("bounds"))
        if r and r[0] <= x <= r[2] and r[1] <= y <= r[3]:
            if exclude_node is not None and not _is_blocker(n, exclude_node):
                continue
            cover = n
    return cover


def find_uncovered_point(node, nodes):
    """Find a tappable point inside node's bounds that no other node covers.

    Samples a 3x3 grid — center first, then the 1/4 and 3/4 points along each
    axis — and returns the first (x, y) not covered by any node drawn after
    `node` in document order. Returns None when every sample is occluded or
    the node's bounds are unparseable. Pure function: unit-testable."""
    r = _bounds_rect(node.get("bounds"))
    if not r:
        return None
    x1, y1, x2, y2 = r
    for fy in (0.5, 0.25, 0.75):
        for fx in (0.5, 0.25, 0.75):
            x = int(x1 + fx * (x2 - x1))
            y = int(y1 + fy * (y2 - y1))
            if is_point_covered(nodes, x, y, node) is None:
                return (x, y)
    return None


def _covers_screen(node, w, h):
    """True if node's bounds cover >=95% of the WxH screen: a window/root
    container, not a real occluder. Pure function: no adb, unit-testable."""
    r = _bounds_rect(node.get("bounds"))
    if not r or w <= 0 or h <= 0:
        return False
    x1, y1, x2, y2 = r
    area = max(0, x2 - x1) * max(0, y2 - y1)
    return area >= 0.95 * w * h


_OVERLAY_CLASS_HINTS = ("dialog", "bottomsheet", "popup", "dropdown",
                        "spinner", "menu")
_CONTAINER_CLASSES = ("viewgroup", "framelayout", "linearlayout",
                      "relativelayout", "coordinatorlayout", "constraintlayout",
                      "cardview", "recyclerview", "scrollview", "listview",
                      "gridview")


def _looks_like_overlay(node, w, h):
    """True if the node looks like a floating overlay (dialog, popup) rather
    than ordinary content or a layout container.

    A --xy tap that lands on a normal widget (button, text field) or an
    edge-to-edge layout container (toolbar, nav bar) is exactly what the
    user asked for — refusing it is a false positive (seen live: the Amazon
    search toolbar "covered" a tap on the search field, and the search
    field itself was then flagged as floating). Only a floating *container*
    — the box of a dialog/popup, not its buttons or text — counts as a
    blocker, plus any node whose class name says dialog/sheet/popup/menu.
    Pure function: no adb, unit-testable."""
    cls = (node.get("class") or "").lower()
    short = cls.split(".")[-1]
    if any(k in cls for k in _OVERLAY_CLASS_HINTS):
        return True
    r = _bounds_rect(node.get("bounds"))
    if not r or w <= 0 or h <= 0:
        return False
    if short not in _CONTAINER_CLASSES:
        return False
    x1, y1, x2, y2 = r
    # A real dialog/popup is a modest floating box; a layout container
    # spans most of the screen width (toolbar, nav bar, list rows).
    return (x2 - x1) < 0.85 * w and (y2 - y1) < 0.85 * h


def topmost_occluder(nodes, x, y, w, h):
    """Topmost node covering (x, y) that looks like a floating overlay.

    For --xy taps there is no named target: the tap lands on the topmost
    node at the point. Full-screen window/root containers are the expected
    background, and ordinary edge-to-edge layout containers (toolbars, nav
    bars) are the tap's natural landing spot — neither counts as blocking.
    Only a floating overlay (dialog, popup) that would steal the tap does.
    Returns the blocker node or None. Pure function: no adb, unit-testable."""
    cover = None
    for n in nodes:  # document order; later = on top, so last match wins
        r = _bounds_rect(n.get("bounds"))
        if r and r[0] <= x <= r[2] and r[1] <= y <= r[3]:
            if not _covers_screen(n, w, h) and _looks_like_overlay(n, w, h):
                cover = n
    return cover


def screen_dims():
    """(width, height) in pixels, from the last dump's rotation attribute."""
    w, h = _screen_wh.split()
    return int(w), int(h)


def parse_normalized_xy(s):
    """Parse '--xy X,Y' with X,Y in 0.0-1.0. Returns (x, y) floats.

    Raises ValueError with a clear message when the format or range is bad."""
    try:
        xs, ys = s.split(",")
        x, y = float(xs.strip()), float(ys.strip())
    except (ValueError, AttributeError):
        raise ValueError("--xy must be 'X,Y' with numbers in 0.0-1.0, got {!r}".format(s))
    if not (0.0 <= x <= 1.0 and 0.0 <= y <= 1.0):
        raise ValueError("--xy values must be within [0.0, 1.0], got {!r}".format(s))
    return x, y


# ------------------------------------------------- compact dump rendering

INTERACTIVE_CLASSES = {"Button", "CheckBox", "Switch", "SeekBar"}


def is_interactive(n):
    """True when a node is tappable/typable: clickable, an EditText, or one of
    Button/CheckBox/Switch/SeekBar (matched on the short class name)."""
    if n.get("clickable"):
        return True
    short = (n.get("class") or "").split(".")[-1]
    return short.endswith("EditText") or short in INTERACTIVE_CLASSES


def node_label(n):
    """Display label: text, or [content-desc] when there is no text."""
    return n.get("text") or ("[%s]" % n["desc"] if n.get("desc") else "")


def compact_bounds_str(bounds):
    """'[12,34][56,78]' -> '12,34-56,78'; '' when unparseable."""
    r = _bounds_rect(bounds)
    return "{},{}-{},{}".format(*r) if r else ""


def format_compact(n, show_bounds=False):
    """One-line compact rendering: 'label (flags) [Class] (cx,cy)'.

    Flags are omitted when empty; bounds only appear when show_bounds is set
    (the --all view)."""
    label = node_label(n)
    flags = []
    if n.get("clickable"):
        flags.append("click")
    if not n.get("enabled", True):
        flags.append("disabled")
    head = label + (" ({})".format(",".join(flags)) if flags else "")
    parts = []
    if head.strip():
        parts.append(head.strip())
    parts.append("[{}]".format((n.get("class") or "").split(".")[-1]))
    if show_bounds:
        cb = compact_bounds_str(n.get("bounds"))
        if cb:
            parts.append(cb)
    cx, cy = n.get("center") or (None, None)
    parts.append("({},{})".format(cx if cx is not None else "?",
                                 cy if cy is not None else "?"))
    return " ".join(parts)


def node_compact(n):
    """Compact dict for --json dumps. Empty fields are omitted entirely."""
    d = {"class": (n.get("class") or "").split(".")[-1]}
    if n.get("text"):
        d["text"] = n["text"]
    if n.get("desc"):
        d["desc"] = n["desc"]
    cx, cy = n.get("center") or (None, None)
    if cx is not None:
        d["x"], d["y"] = cx, cy
    if n.get("clickable"):
        d["clickable"] = True
    if not n.get("enabled", True):
        d["enabled"] = False
    return d


def compact_visible(n, include_all):
    """True when a node belongs in the compact dump: it is interactive or has
    text/content-desc. include_all (--all) keeps every node."""
    return include_all or is_interactive(n) or bool(node_label(n))


def screen_fingerprint(nodes):
    """Hash screen STRUCTURE, not content (app-automating fingerprinting pattern).

    Primary: sorted resource-id values of visible nodes. A cart with 2 items
    and the same cart with 3 items hash identically — the map doesn't grow a
    node per visit. Text is deliberately excluded (immune to badge counts,
    timestamps, and dynamic content).

    Fallback (Flutter/RN expose no resource-ids): hash the depth-tagged
    class-name hierarchy shape instead. Coarser, but prevents the whole app
    collapsing to one node.

    Returns a hex digest string. Only stdlib (hashlib)."""
    import hashlib
    # Collect resource-ids from visible nodes
    rids = sorted(n.get("rid") or "" for n in nodes
                  if (n.get("class") or node_label(n) or n.get("clickable"))
                  and n.get("rid"))
    if rids:
        # Structure hash: sorted resource-ids (content-independent)
        h = hashlib.sha256()
        h.update("\x00".join(rids).encode("utf-8"))
        return "rid:" + h.hexdigest()[:16]

    # Fallback: depth-tagged class hierarchy shape
    # Depth from parent chain length
    shapes = []
    for n in nodes:
        if not (n.get("class") or node_label(n) or n.get("clickable")):
            continue
        depth = len(n.get("parents", []))
        cls = (n.get("class") or "").split(".")[-1]
        shapes.append("{}:{}".format(depth, cls))
    shapes.sort()
    h = hashlib.sha256()
    h.update("\x00".join(shapes).encode("utf-8"))
    return "cls:" + h.hexdigest()[:16]


def visible_lines(nodes, include_all=False):
    """Compact one-line-per-node rendering of walk() nodes, in screen order.
    Shared by dump, snap, and settle diffing so all three see the same rows."""
    return [format_compact(n, show_bounds=include_all)
            for n in nodes
            if compact_visible(n, include_all)
            # drop the <hierarchy> root itself (no class/label/clickable)
            and (n["class"] or node_label(n) or n["clickable"])]


def wake():
    try:
        if scrcpy_send("wake"):
            return
    except Exception:
        pass
    if os.environ.get("BURNER_SCRCPY") == "0":
        return  # test copy: phone is stay-awake on charger; skip the adb keyevent
    adb_or_ensure("shell", "input", "keyevent", "224")


def wake_async():
    """Start wake() in the background; join the returned thread before tapping."""
    import threading
    t = threading.Thread(target=wake, daemon=True)
    t.start()
    return t


def tap_center(x, y, waker=None):
    # Use adb input tap: orientation-aware and reliable. Scrcpy taps are
    # faster (48ms vs 280ms) but the server's cached display metrics go stale
    # when the foreground app rotates (Chrome forces landscape, launcher is
    # portrait), causing taps to land wrong and background the app.
    # Scrcpy is still used for keys (home/back/wake) which are orientation-independent.
    # waker: a wake_async() thread already in flight (overlaps the lookup).
    if waker is None:
        wake()
    else:
        waker.join()
    adb_or_ensure("shell", "input", "tap", x, y)
    u2_invalidate()


def snap_save(nodes, include_all=False):
    """Number the visible nodes @e1..@eN and persist handles to SNAP_PATH.

    Returns the list of (handle, line) pairs. Handles are single-use: any
    mutating burner action deletes the snap file via snap_invalidate().
    Each snap gets a generation number; handles render as @eN~s<gen> so a
    stale handle from an older snap is rejected with a clear error instead
    of silently tapping the wrong coordinates (agent-device ref-pinning pattern)."""
    filt = [n for n in nodes
            if compact_visible(n, include_all)
            # drop the <hierarchy> root itself (no class/label/clickable)
            and (n["class"] or node_label(n) or n["clickable"])]
    # Generation: monotonic counter persisted alongside the snap.
    gen_path = os.path.join(SNAP_DIR, "snap.gen")
    try:
        with open(gen_path) as f:
            gen = int(f.read().strip() or "0") + 1
    except (OSError, ValueError):
        gen = 1
    entries = {}
    numbered = []
    for i, n in enumerate(filt, 1):
        cx, cy = n.get("center") or (None, None)
        entries[str(i)] = {"x": cx, "y": cy,
                           "label": node_label(n),
                           "class": (n.get("class") or "").split(".")[-1]}
        numbered.append(("@e{}~s{}".format(i, gen),
                         format_compact(n, show_bounds=include_all)))
    try:
        os.makedirs(SNAP_DIR, exist_ok=True)
        with open(SNAP_PATH, "w") as f:
            json.dump({"ts": time.time(), "gen": gen, "entries": entries}, f)
        with open(gen_path, "w") as f:
            f.write(str(gen))
    except OSError as e:
        print("warning: could not save snap: {}".format(e), file=sys.stderr)
    return numbered


def snap_resolve(handle):
    """Resolve '@eN' or '@eN~s<gen>' to (x, y) pixel coords from the last burner snap.

    Returns (x, y) or raises ValueError with a human-readable reason.
    A pinned handle (@eN~s<gen>) whose generation does not match the current
    snap is rejected explicitly — the coordinates may belong to a different
    screen."""
    m = re.fullmatch(r"@e(\d+)(?:~s(\d+))?", (handle or "").strip())
    if not m:
        raise ValueError('not a snap handle: "{}"'.format(handle))
    try:
        with open(SNAP_PATH) as f:
            snap = json.load(f)
    except (OSError, ValueError):
        raise ValueError("no snap saved (run `burner snap` first)")
    if time.time() - snap.get("ts", 0) > SNAP_TTL:
        raise ValueError("snap expired (run `burner snap` again)")
    cur_gen = snap.get("gen", 0)
    want_gen = m.group(2)
    if want_gen is not None and int(want_gen) != cur_gen:
        raise ValueError(
            "handle {} is from snap generation {}, current snap is generation {} "
            "(run `burner snap` again for fresh handles)".format(handle, want_gen, cur_gen))
    entry = snap.get("entries", {}).get(m.group(1))
    if entry is None:
        raise ValueError("no such handle {} in current snap".format(handle))
    if entry.get("x") is None:
        raise ValueError("handle {} has no tap point".format(handle))
    return entry["x"], entry["y"]


def cmd_dump(args):
    root = ui_dump()
    nodes = [n for n in walk(root)
             if compact_visible(n, args.all)
             # drop the <hierarchy> root itself (no class/label/clickable)
             and (n["class"] or node_label(n) or n["clickable"])]
    if as_json(args):
        print(json.dumps({"ok": True,
                          "nodes": [node_compact(n) for n in nodes]}))
        return 0
    if args.verbose:
        # Legacy format: label (+flags) [Class] [x1,y1][x2,y2]
        for n in nodes:
            t = node_label(n)
            flags = []
            if n["clickable"]:
                flags.append("click")
            if not n["enabled"]:
                flags.append("disabled")
            if n["focused"]:
                flags.append("focused")
            print("{}{} [{}] {}".format(
                t, " ({})".format(",".join(flags)) if flags else "",
                n["class"].split(".")[-1], n["bounds"]))
    else:
        for n in nodes:
            print(format_compact(n, show_bounds=args.all))
    return 0


def cmd_snap(args):
    """Numbered snapshot: same rows as dump, prefixed @e1..@eN.

    Handles resolve in `burner tap @eN` (exact coordinates, no re-matching).
    The snap file is deleted by any mutating action, so handles never
    outlive the screen they were taken from."""
    root = ui_dump()
    nodes = walk(root)
    numbered = snap_save(nodes, include_all=args.all)
    if as_json(args):
        print(json.dumps({"ok": True,
                          "handles": [{"handle": h, "line": line}
                                      for h, line in numbered]}))
        return 0
    for h, line in numbered:
        print("{} {}".format(h, line))
    return 0


def _capture_evidence(tag):
    """Capture failure evidence: screenshot + compact dump. Returns a dict
    with 'screenshot' (path or None) and 'screen' (list of top dump lines).
    Best-effort: never raises, never blocks the error report."""
    ev = {"screenshot": None, "screen": []}
    try:
        # Screenshot via the repo's screenshot.sh (wakes screen, saves to shots/).
        r = subprocess.run([os.path.join(ROOT, "screenshot.sh")],
                           capture_output=True, text=True, timeout=30)
        out = (r.stdout or "").strip().splitlines()
        # screenshot.sh prints the saved path on its last line.
        for line in reversed(out):
            if line.endswith(".png") and os.path.exists(line):
                ev["screenshot"] = line
                break
    except Exception:
        pass
    try:
        nodes = walk(ui_dump())
        # Top 15 nodes with text/desc, compact one-line format.
        for n in nodes[:50]:
            label = n.get("text") or n.get("desc") or ""
            if label:
                cls = (n.get("class") or "").split(".")[-1]
                ev["screen"].append("{} [{}]".format(label[:60], cls))
            if len(ev["screen"]) >= 15:
                break
    except Exception:
        pass
    return ev


def _format_evidence(ev):
    """Human-readable evidence block for stderr."""
    lines = []
    if ev.get("screenshot"):
        lines.append("  screenshot: {}".format(ev["screenshot"]))
    if ev.get("screen"):
        lines.append("  screen was showing:")
        for s in ev["screen"][:10]:
            lines.append("    - {}".format(s))
    return "\n".join(lines)


def _tap_fail(args, msg):
    """Report a tap failure: human text on stderr, pure JSON on stdout with --json.
    Attaches failure evidence (screenshot + screen contents) unless --no-evidence."""
    ev = None
    if not getattr(args, "no_evidence", False):
        ev = _capture_evidence("tap-fail")
        ev_txt = _format_evidence(ev)
        if ev_txt:
            msg = msg + "\n" + ev_txt
    print(msg, file=sys.stderr)
    if as_json(args):
        out = {"ok": False, "error": msg}
        if ev:
            out["evidence"] = ev
        print(json.dumps(out))
    return 1


def _tap_ok(args, label, xy, via=None):
    """Report a successful tap. xy is (x, y) or None for on-device daemon taps."""
    if as_json(args):
        print(json.dumps({"ok": True, "tapped": {
            "text": label,
            "x": xy[0] if xy else None,
            "y": xy[1] if xy else None}}))
    elif via:
        print("tapped {} ({})".format(label, via))
    else:
        print("tapped {} @ {}".format(label, xy))
    return 0


def _tap_refused(args, x, y, cover):
    """Refuse a tap whose point is covered by another node (exit 1)."""
    msg = 'tap refused: point ({},{}) is covered by "{}" [{}] {}'.format(
        x, y, cover.get("text") or cover.get("desc") or "",
        (cover.get("class") or "").split(".")[-1], cover.get("bounds"))
    msg += (chr(10) + "If the screenshot shows that button is really there "
            "(web pages and some apps hide their controls from the dump), "
            "retry with --no-occlusion-check. If a dialog or sheet is in "
            "the way, close it first.")
    return _tap_fail(args, msg)


def settle_lines(prev_lines, timeout=10, quiet=0.5, poll=0.3, prev_fp=None):
    """Re-read the screen until it stops changing.

    Returns (added, removed, final_fp): compact lines that appeared/disappeared
    relative to prev_lines (the pre-action screen), plus the fingerprint of
    the final screen. Reads every `poll` seconds; stops after `quiet` seconds
    with no change (minimum two reads, so an action that changes nothing
    reports "unchanged" instead of racing an animation) or at `timeout`
    seconds. A read that shrinks to <=20% of a 12+ element screen is a
    partial mid-transition dump and is retried at 250/400/600ms before being
    trusted.

    The screen fingerprint (structure hash, see screen_fingerprint) is used
    as a cheaper "same screen" signal: if the fingerprint matches, the
    structure is unchanged even when text content (badges, timestamps)
    differs. Pass prev_fp (fingerprint of the pre-action screen) to enable."""
    deadline = time.time() + timeout
    cur = list(prev_lines)
    cur_fp = prev_fp
    quiet_start = None
    reads = 0
    while True:
        time.sleep(poll)
        if time.time() > deadline:
            break
        nodes = walk(ui_dump())
        nxt = visible_lines(nodes)
        nxt_fp = screen_fingerprint(nodes)
        reads += 1
        if len(cur) >= 12 and len(nxt) * 5 <= len(cur):
            # Partial dump mid-transition: retry at 250/400/600ms.
            for wait in (0.25, 0.15, 0.2):
                time.sleep(wait)
                nodes = walk(ui_dump())
                retry = visible_lines(nodes)
                reads += 1
                nxt = retry
                nxt_fp = screen_fingerprint(nodes)
                if not (len(cur) >= 12 and len(nxt) * 5 <= len(cur)):
                    break
        # Same screen if EITHER text lines match OR structure fingerprint matches.
        # Fingerprint is immune to badge counts/timestamps that change text.
        same = (nxt == cur) or (prev_fp and nxt_fp == prev_fp and nxt_fp == cur_fp)
        if same:
            if quiet_start is None:
                quiet_start = time.time()
            if time.time() - quiet_start >= quiet and reads >= 2:
                break
        else:
            quiet_start = None
        cur = nxt
        cur_fp = nxt_fp
    added = [l for l in cur if l not in prev_lines]
    removed = [l for l in prev_lines if l not in cur]
    return added, removed, cur_fp


def _print_settle_diff(added, removed, cap=80):
    """Human-readable settle diff: '+...'/'-...' lines, capped."""
    if not added and not removed:
        print("unchanged")
        return
    print("settled: +{} -{}".format(len(added), len(removed)))
    shown = 0
    for prefix, lines in (("+", added), ("-", removed)):
        for l in lines:
            if shown >= cap:
                print("... {} more".format(len(added) + len(removed) - cap))
                return
            print("{} {}".format(prefix, l))
            shown += 1


def _tap_ambiguous(args, used, hits, fuzzy_used):
    """Refuse an ambiguous tap: list up to 5 candidates, exit 1."""
    lines = ["  [{}] {}".format(i, format_compact(h))
             for i, h in enumerate(hits[:5])]
    if len(hits) > 5:
        lines.append("  ... and {} more".format(len(hits) - 5))
    msg = ('ambiguous tap: "{}" matched {} candidates{}:\n{}\n'
           "use --index N or a longer label").format(
               used, len(hits), " (fuzzy)" if fuzzy_used else "",
               "\n".join(lines))
    return _tap_fail(args, msg)


def cmd_tap(args):
    # Occlusion checking needs the local node list, so the daemon fast path
    # (on-device click / coord lookup) only runs with --no-occlusion-check.
    # Validate args before waking the phone. Wake runs concurrently with the
    # lookup either way.
    if args.xy is None and not args.text:
        return _tap_fail(args, "tap needs a text or --xy X,Y")
    xy_norm = None
    if args.xy is not None:
        try:
            xy_norm = parse_normalized_xy(args.xy)
        except ValueError as e:
            return _tap_fail(args, str(e))
    # @eN snap handles resolve locally (no phone needed yet); a bad handle
    # is a usage error, reported before waking the device.
    snap_xy = None
    if args.xy is None and args.text and args.text.strip().startswith("@e"):
        try:
            snap_xy = snap_resolve(args.text)
        except ValueError as e:
            return _tap_fail(args, str(e))
    waker = wake_async()
    if args.no_occlusion_check and args.xy is None and snap_xy is None \
            and not args.fuzzy and args.index is None and not args.settle:
        r = u2sock("click_text", args.text, timeout=20)
        if r is not None and r != U2_NOT_FOUND:
            try:
                hit = json.loads(r)
            except ValueError:
                hit = None
            if isinstance(hit, dict) and hit.get("clicked"):
                # daemon clicked on-device (exact text, 1 RPC)
                waker.join()
                return _tap_ok(args, args.text, None, via="u2")
            if isinstance(hit, dict) and "x" in hit:
                xy = (hit["x"], hit["y"])
                tap_center(*xy, waker=waker)
                return _tap_ok(args, hit["text"] or hit["desc"] or args.text, xy)
    waker.join()
    root = ui_dump()
    _update_screen_from_dump(root)
    nodes = walk(root)

    if args.xy is not None or snap_xy is not None:
        w, h = screen_dims()
        if snap_xy is not None:
            x, y = snap_xy
            tap_label = args.text.strip()
        else:
            # Normalized 0.0-1.0 coordinates -> pixels (validated above).
            nx, ny = xy_norm
            x, y = int(nx * w), int(ny * h)
            tap_label = "--xy {}".format(args.xy)
        if not args.no_occlusion_check:
            cover = topmost_occluder(nodes, x, y, w, h)
            if cover is not None:
                return _tap_refused(args, x, y, cover)
        prev_lines = visible_lines(nodes) if args.settle else None
        prev_fp = screen_fingerprint(nodes)  # for nav memory (no extra dump)
        from_nodes = nodes  # for nav recording
        tap_center(x, y)
        if args.settle:
            added, removed, final_fp = settle_lines(prev_lines, prev_fp=prev_fp)
            # Record full transition: we know both from and to screens
            nav_record_action(from_nodes, 'tap "{}"'.format(tap_label), to_fp=final_fp, ok=True)
            return _tap_settled_ok(args, tap_label, (x, y), added, removed, final_fp)
        # No settle: record action taken, destination unknown (no extra round-trip)
        nav_record_action(from_nodes, 'tap "{}"'.format(tap_label), to_fp=None, ok=True)
        return _tap_ok(args, tap_label, (x, y))

    # Fallback selectors: "a || b" tries each label in order (first hit wins).
    selectors = [s.strip() for s in args.text.split("||")]
    hits, used, fuzzy_used = [], selectors[0], False
    for sel in selectors:
        hits = find_nodes(nodes, sel, exact=not args.fuzzy)
        if hits:
            used = sel
            break
    if not hits and not args.fuzzy:
        # Auto-retry with fuzzy match before giving up (saves a manual retry
        # on long labels like Amazon order titles).
        for sel in selectors:
            hits = find_nodes(nodes, sel, exact=False)
            if hits:
                used, fuzzy_used = sel, True
                break
    if not hits:
        return _tap_fail(args, 'no match for "{}"'.format(args.text))
    if len(hits) > 1 and args.index is None:
        return _tap_ambiguous(args, used, hits, fuzzy_used)
    node = hits[args.index] if args.index is not None \
        and args.index < len(hits) else hits[0]
    xy = clickable_target(node)
    if xy[0] is None:
        return _tap_fail(args, "match has no tappable bounds")
    if not args.no_occlusion_check:
        cover = is_point_covered(nodes, xy[0], xy[1], node)
        if cover is not None:
            alt = find_uncovered_point(node, nodes)
            if alt is not None:
                xy = alt
                if not as_json(args):
                    print("tap point covered, using {}".format(xy))
            else:
                return _tap_refused(args, xy[0], xy[1], cover)
    tap_label = node["text"] or node["class"]
    prev_lines = visible_lines(nodes) if args.settle else None
    prev_fp = screen_fingerprint(nodes)  # for nav memory (no extra dump)
    from_nodes = nodes  # for nav recording
    tap_center(*xy)
    if args.settle:
        added, removed, final_fp = settle_lines(prev_lines, prev_fp=prev_fp)
        # Record full transition: we know both from and to screens
        nav_record_action(from_nodes, 'tap "{}"'.format(tap_label), to_fp=final_fp, ok=True)
        return _tap_settled_ok(args, tap_label, xy, added, removed, final_fp)
    # No settle: record action taken, destination unknown (no extra round-trip)
    nav_record_action(from_nodes, 'tap "{}"'.format(tap_label), to_fp=None, ok=True)
    return _tap_ok(args, tap_label, xy)


def nav_record_action(from_nodes, action_desc, to_fp=None, ok=True):
    """Record a navigation action. from_nodes is the walk() output from the
    pre-action dump (already taken, no extra round-trip). to_fp is the
    destination fingerprint if known (e.g., from settle), else None.
    
    Typed text content is NEVER recorded — action_desc for type operations
    must be "type" or "type <field-hint>", never the actual text."""
    try:
        from_fp = screen_fingerprint(from_nodes)
        nav_record(from_fp, action_desc, to_fp, ok=ok)
    except Exception:
        pass


def _tap_settled_ok(args, label, xy, added, removed, final_fp=None):
    """Report a successful tap plus its settle diff."""
    # Record navigation memory: we know the from-screen (prev_fp was passed
    # to settle_lines) and the to-screen (final_fp from settle).
    # Note: prev_fp isn't passed here, so we record with from_fp=None.
    # The full transition is recorded by the caller via nav_record.
    if as_json(args):
        print(json.dumps({"ok": True,
                          "tapped": {"text": label, "x": xy[0], "y": xy[1]},
                          "settled": {"added": added[:80],
                                      "removed": removed[:80]}}))
        return 0
    print("tapped {} @ {}".format(label, xy))
    _print_settle_diff(added, removed)
    return 0


def _wait_fail(args, msg):
    """Wait failure: human text on stderr, pure JSON on stdout with --json.
    Attaches failure evidence (screenshot + screen contents) unless --no-evidence."""
    ev = None
    if not getattr(args, "no_evidence", False):
        ev = _capture_evidence("wait-fail")
        ev_txt = _format_evidence(ev)
        if ev_txt:
            msg = msg + "\n" + ev_txt
    print(msg, file=sys.stderr)
    if as_json(args):
        out = {"ok": False, "error": msg}
        if ev:
            out["evidence"] = ev
        print(json.dumps(out))
    return 1


def _wait_found(args, text, bounds, enabled, node=None):
    if as_json(args):
        found = {"text": text, "bounds": bounds}
        if node is not None:
            found = node_compact(node)
        print(json.dumps({"ok": True, "found": found}))
    else:
        print("found: {} {} {}".format(text, bounds,
                                       "disabled" if not enabled else ""))
    return 0


def _wait_gone(args):
    if as_json(args):
        print(json.dumps({"ok": True, "gone": True}))
    else:
        print("gone: {}".format(args.text))
    return 0


def cmd_wait(args):
    # Fast path: the daemon polls (0.25s interval, fresh dump each poll) and
    # returns the matched node — one socket call, no per-poll RPC from here.
    # Matches exact label first, then case-insensitive substring (text/desc).
    r = u2sock("wait_for", json.dumps({"text": args.text, "timeout": args.timeout,
                                       "absent": args.absent}),
               timeout=args.timeout + 30)
    if r == U2_NOT_FOUND:
        return _wait_fail(args, 'timeout waiting for "{}"'.format(args.text))
    if r is not None:
        try:
            n = json.loads(r)
        except ValueError:
            n = None
        if isinstance(n, dict) and n.get("gone"):
            return _wait_gone(args)
        if isinstance(n, dict) and n.get("found"):
            return _wait_found(args, n["text"] or n["desc"] or args.text,
                               n["bounds"], n["enabled"])
    # Legacy path.
    deadline = time.time() + args.timeout
    while True:
        nodes = walk(ui_dump())
        hits = find_nodes(nodes, args.text, exact=not args.fuzzy)
        if args.absent and not hits:
            return _wait_gone(args)
        if not args.absent and hits:
            n = hits[0]
            return _wait_found(args, n["text"], n["bounds"], n["enabled"], node=n)
        if time.time() > deadline:
            return _wait_fail(args, 'timeout waiting for "{}"'.format(args.text))
        time.sleep(2)


def esc_char(c):
    if c == " ":
        return "%s"
    if re.match(r"[A-Za-z0-9]", c):
        return c
    return "\\" + c


# ------------------------------------------------- unicode input (ADBKeyboard)

ADBKEYBOARD_IME = "com.android.adbkeyboard/.AdbIME"


def needs_unicode_route(text):
    """True when text contains any non-ASCII char (emoji, CJK, accents) —
    plain `input text` mangles those, so the ADBKeyboard route is needed."""
    return any(ord(c) > 127 for c in text)


def get_current_ime():
    """Return the current default IME id (for restore), or None if unreadable."""
    r = adb("shell", "settings", "get", "secure", "default_input_method")
    return (r.stdout or "").strip() or None


def set_ime(ime_id):
    """Switch the active IME. Returns True on success."""
    r = adb("shell", "ime", "set", ime_id)
    return r.returncode == 0


def _sh_quote(s):
    """Single-quote a string for the device shell.

    `adb shell` joins its args with spaces and re-parses them on-device,
    so any message containing spaces must be quoted or it gets split
    (the broadcast then silently types nothing)."""
    return "'" + s.replace("'", "'\\''") + "'"


def broadcast_adbkeyboard_text(text):
    """Send text through the ADBKeyboard IME broadcast.

    Uses subprocess list args (via adb()) so no *local* shell quoting is
    involved — but the message itself is quoted for the *device* shell,
    which re-splits `adb shell` args. Arbitrary unicode passes through
    intact inside single quotes."""
    r = adb("shell", "am", "broadcast", "-a", "ADB_INPUT_TEXT",
            "--es", "msg", _sh_quote(text))
    return r.returncode == 0


def type_via_adbkeyboard(text, field_xy=None, clear=False, clear_keys=20):
    """Type text through the ADBKeyboard IME (handles emoji/CJK/accents).

    Switches to ADBKeyboard, focuses field_xy, broadcasts the text, then
    restores the previous IME. Prints the route used. Small adb wrappers
    (get_current_ime/set_ime/broadcast_adbkeyboard_text) keep this mockable."""
    prev = get_current_ime()
    # Focus the field BEFORE switching IMEs: tapping while the IME switch
    # is in flight breaks ADBKeyboard's input connection and the broadcast
    # is silently dropped (seen 2026-09-30).
    if field_xy is not None and field_xy[0] is not None:
        tap_center(*field_xy)
        time.sleep(0.6)
    set_ime(ADBKEYBOARD_IME)
    # The IME switch needs a moment to bind to the focused field; without
    # this the ADB_INPUT_TEXT broadcast lands on a null InputConnection and
    # the text is silently dropped (seen 2026-09-30).
    time.sleep(1.0)
    try:
        if clear:
            for _ in range(clear_keys):
                adb_or_ensure("shell", "input", "keyevent", "67")
            time.sleep(0.5)
        broadcast_adbkeyboard_text(text)
        # The broadcast is processed async by the IME; restoring the
        # previous IME immediately can tear down ADBKeyboard's
        # InputConnection before it commits the text (seen 2026-09-30).
        time.sleep(0.8)
    finally:
        if prev:
            set_ime(prev)
    print("typed {} chars (adbkeyboard)".format(len(text)))
    return 0


def cmd_type(args):
    # Nav memory: record that a field was filled (NEVER the content).
    # The action string is "type" or "type <field-hint>", never the actual text.
    try:
        field_hint = args.field if getattr(args, "field", None) else "field"
        # Use nodes if available for from_fp, else None (no extra round-trip)
        nav_record(None, 'type {}'.format(field_hint), None, ok=True)
    except Exception:
        pass
    # Route selection: --ascii forces the legacy path, --unicode forces the
    # ADBKeyboard path, otherwise auto-detect on non-ASCII content.
    if args.ascii:
        use_unicode = False
    elif args.unicode:
        use_unicode = True
    else:
        use_unicode = needs_unicode_route(args.text)
    if use_unicode:
        nodes = walk(ui_dump())
        xy = None
        if args.field:
            hits = find_nodes(nodes, args.field, exact=True)
            if not hits:
                print('field "{}" not found'.format(args.field), file=sys.stderr)
                return 1
            xy = clickable_target(hits[0])
        else:
            for n in nodes:
                if n["focused"] and "EditText" in n["class"]:
                    xy = clickable_target(n)
                    break
        return type_via_adbkeyboard(args.text, xy, clear=args.clear,
                                    clear_keys=args.clear_keys)
    # Fast path: atomic ACTION_SET_TEXT via uiautomator2 (one shot, watchers fire).
    # set_text replaces the field content, so --clear is implicit here.
    if u2sock("health", timeout=10) is not None:
        try:
            nodes = walk(ui_dump())
            target = None
            if args.field:
                hits = find_nodes(nodes, args.field, exact=True)
                if hits:
                    target = hits[0]
            else:
                for n in nodes:
                    if n["focused"] and "EditText" in n["class"]:
                        target = n
                        break
            if target is not None:
                # tap to focus (scrcpy, fast), then atomic set_text on the focused field
                xy = clickable_target(target)
                if xy[0] is not None:
                    tap_center(*xy)
                    time.sleep(0.6)
                out = u2sock("set_text", json.dumps({"text": args.text}), timeout=40)
                if out is not None:
                    print("typed {} chars (atomic)".format(len(args.text)))
                    return 0
                print("u2 set_text failed, falling back to char-by-char", file=sys.stderr)
            elif args.field:
                print('field "{}" not found'.format(args.field), file=sys.stderr)
                return 1
        except Exception as e:
            print("fast type failed, falling back: {}".format(e), file=sys.stderr)
    # Legacy char-by-char path (Bloks/RN-safe).
    nodes = walk(ui_dump())
    if args.field:
        hits = find_nodes(nodes, args.field, exact=True)
        if not hits:
            print('field "{}" not found'.format(args.field), file=sys.stderr)
            return 1
        xy = clickable_target(hits[0])
        tap_center(*xy)
        time.sleep(0.8)
    if args.clear:
        for _ in range(args.clear_keys):
            adb_or_ensure("shell", "input", "keyevent", "67")
        time.sleep(0.5)
    delay = 0.4 if args.slow else 0.2
    for ch in args.text:
        if ch == "\n":
            adb_or_ensure("shell", "input", "keyevent", "66")
        else:
            adb_or_ensure("shell", "input", "text", esc_char(ch))
        time.sleep(delay)
    u2_invalidate()
    print("typed {} chars (char-by-char)".format(len(args.text)))
    return 0


def cmd_press(args):
    # Key combos: --ctrl/--shift/--alt/--meta send the modifier keyevent
    # before the main key (Android tracks the modifier state).
    mods = []
    if getattr(args, "ctrl", False):
        mods.append("KEYCODE_CTRL_LEFT")
    if getattr(args, "shift", False):
        mods.append("KEYCODE_SHIFT_LEFT")
    if getattr(args, "alt", False):
        mods.append("KEYCODE_ALT_LEFT")
    if getattr(args, "meta", False):
        mods.append("KEYCODE_META_LEFT")
    repeat = max(1, getattr(args, "repeat", 1) or 1)
    delay_ms = getattr(args, "delay", 120) or 0

    def send_one(key):
        try:
            if scrcpy_send("key {}".format(key)):
                return True
        except Exception as e:
            print("scrcpy key failed, falling back: {}".format(e), file=sys.stderr)
        wake()
        adb_or_ensure("shell", "input", "keyevent", key)
        return True

    for i in range(repeat):
        for m in mods:
            send_one(m)
        send_one(args.key)
        # Release modifiers in reverse order (best-effort; Android usually
        # clears the modifier state after the combo is consumed).
        for m in reversed(mods):
            send_one(m)
        if delay_ms and i < repeat - 1:
            time.sleep(delay_ms / 1000.0)
    u2_invalidate()
    label = args.key
    if mods:
        label = "+".join(m.replace("KEYCODE_", "").replace("_LEFT", "") for m in mods) + "+" + label
    if repeat > 1:
        label += " x{}".format(repeat)
    # Nav memory: record the press action (no pre-dump available, so from_fp
    # is None — the action is still useful for the action vocabulary).
    # No extra device round-trip for bookkeeping.
    try:
        nav_record(None, 'press {}'.format(label), None, ok=True)
    except Exception:
        pass
    print("pressed {}".format(label))
    return 0


def cmd_state(args):
    r = adb_or_ensure("shell", "dumpsys", "activity", "activities")
    m = re.search(r"mFocusedApp=.*?\s+u0\s+(\S+)", r.stdout)
    app = m.group(1) if m else "?"
    nodes = walk(ui_dump())
    texts = [n["text"] for n in nodes if n["text"]][:25]
    if as_json(args):
        print(json.dumps({"ok": True, "app": app, "texts": texts}))
        return 0
    print("app: {}".format(app))
    for t in texts:
        print("  " + t)
    return 0


def parse_status(battery, power, window, df, packages, model, android):
    """Turn raw dumpsys/df/pm output into a small status dict."""
    def num(pattern, text):
        m = re.search(pattern, text or "")
        return int(m.group(1)) if m else None
    level = num(r"level:\s*(\d+)", battery)
    plugged = bool(re.search(r"(AC|USB|Wireless) powered:\s*true", battery or ""))
    screen = "on" if re.search(r"mWakefulness=Awake", power or "") else (
        "off" if power else None)
    m = re.search(r"mCurrentFocus=.*?\s([\w.]+)/", window or "")
    used = None
    for line in (df or "").splitlines()[1:]:
        m2 = re.search(r"(\d+)%", line)
        if m2:
            used = int(m2.group(1))
    apps = [l.split(":", 1)[1].strip() for l in (packages or "").splitlines()
            if l.startswith("package:")]
    return {"online": True, "model": (model or "").strip() or None,
            "android": (android or "").strip() or None,
            "battery_percent": level, "charging": plugged, "screen": screen,
            "app": m.group(1) if m else None, "storage_used_percent": used,
            "installed_apps": len(apps)}


def split_marked(text):
    """Split output made of '@@name' marker lines into {name: text}."""
    nl = chr(10)
    out, name, buf = {}, None, []
    for line in (text or "").splitlines():
        if line.startswith("@@"):
            if name is not None:
                out[name] = nl.join(buf) + nl
            name, buf = line[2:].strip(), []
        elif name is not None:
            buf.append(line)
    if name is not None:
        out[name] = nl.join(buf) + nl
    return out


def cmd_status(args):
    """One-call health summary, so nobody has to dig through dumpsys (which
    can also expose accounts and other personal details)."""
    if not ensure(heal_fast_paths=False):
        if as_json(args):
            print(json.dumps({"online": False}))
        else:
            print("offline: the phone isn't reachable. Check that it's on "
                  "Wi-Fi and Wireless debugging is on, then run `burner ensure`.")
        return 1

    # One adb round trip instead of seven: each call through the tunnel costs
    # a few seconds. grep on the phone keeps the big dumpsys output off the wire.
    script = ("echo @@battery; dumpsys battery; "
              "echo @@power; dumpsys power | grep mWakefulness=; "
              "echo @@window; dumpsys window | grep mCurrentFocus; "
              "echo @@df; df /data; "
              "echo @@pkgs; pm list packages -3; "
              "echo @@model; getprop ro.product.model; "
              "echo @@android; getprop ro.build.version.release")
    r = adb("shell", script, timeout=45)
    parts = split_marked(r.stdout if r.returncode == 0 else "")
    st = parse_status(
        parts.get("battery", ""), parts.get("power", ""),
        parts.get("window", ""), parts.get("df", ""),
        parts.get("pkgs", ""), parts.get("model", ""),
        parts.get("android", ""))
    if as_json(args):
        print(json.dumps(st))
        return 0
    print("online: {} (Android {})".format(st["model"] or "phone", st["android"] or "?"))
    if st["battery_percent"] is not None:
        print("battery: {}%{}".format(st["battery_percent"],
                                      ", charging" if st["charging"] else ", not charging"))
    print("screen: {}".format(st["screen"] or "?"))
    print("open app: {}".format(st["app"] or "home screen or unknown"))
    if st["storage_used_percent"] is not None:
        print("storage: {}% used".format(st["storage_used_percent"]))
    print("apps installed by the user: {}".format(st["installed_apps"]))
    return 0


def foreground_package():
    """Package of the app in front, or None if it can't be read."""
    r = adb("shell", "dumpsys", "activity", "activities", timeout=20)
    m = re.search(r"mFocusedApp=.*?\s+u0\s+([\w.]+)/", r.stdout or "")
    if not m:
        m = re.search(r"mResumedActivity.*?\s+u0\s+([\w.]+)/", r.stdout or "")
    return m.group(1) if m else None


def cmd_start(args):
    launch = ["shell", "monkey", "-p", args.package,
              "-c", "android.intent.category.LAUNCHER", "1"]
    adb_or_ensure(*launch)
    # Another app (the Play Store's transparent screen, a dialog host) can
    # keep the front after a launch. Check, and if so go Home first and
    # launch again before reporting success.
    for attempt in range(2):
        time.sleep(1.5)
        front = foreground_package()
        if front is None or front == args.package:
            break
        if attempt == 0:
            adb_or_ensure("shell", "input", "keyevent", "KEYCODE_HOME")
            time.sleep(0.8)
            adb_or_ensure(*launch)
        else:
            print("{} didn't come to the front; {} is still open. Try "
                  "`burner press BACK` or `burner press HOME`, then start it "
                  "again.".format(args.package, front), file=sys.stderr)
            u2_invalidate()
            return 1
    u2_invalidate()
    # Nav memory: record app launch (no pre-dump, so from_fp is None)
    try:
        nav_record(None, 'start {}'.format(args.package), None, ok=True)
    except Exception:
        pass
    print("launched {}".format(args.package))
    return 0


def cmd_shot(args):
    cmd = [os.path.join(ROOT, "screenshot.sh")]
    out = getattr(args, "out", None)
    if out:
        # screenshot.sh runs from the repo dir, so pass an absolute path.
        out = os.path.abspath(os.path.expanduser(out))
        if os.path.isdir(out):
            # A new name every time: chat apps cache images by file name and
            # would keep showing the old screenshot.
            out = os.path.join(out, "burner-{}.png".format(
                time.strftime("%Y%m%d-%H%M%S")))
        os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
        cmd.append(out)
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    path = (r.stdout or "").strip().splitlines()[-1:] or [""]
    path = os.path.join(ROOT, path[0]) if path[0] and not os.path.isabs(path[0]) else path[0]
    if r.returncode != 0 or not path or not os.path.isfile(path):
        print("screenshot failed: {}".format(
            ((r.stdout or "") + (r.stderr or "")).strip()[:200] or "no output"),
            file=sys.stderr)
        return 1
    print(path)
    return 0

# ------------------------------------------------------- Gmail code pull

CODE_RES = [
    re.compile(r"(\d{6,10})\s+is your"),            # Facebook: "42327079 is your Facebook code"
    re.compile(r"Enter this code:\s*(\d{4,10})"),
    re.compile(r"verification code\D{0,30}(\d{4,10})", re.I),
    re.compile(r"code\D{0,20}(\d{4,10})", re.I),
]


def extract_code(subject, body):
    for text in (subject or "", body or ""):
        for rx in CODE_RES:
            m = rx.search(text)
            if m:
                return m.group(1)
    for text in (subject or "", body or ""):
        m = re.search(r"\b(\d{4,10})\b", text)
        if m:
            return m.group(1)
    return None


def gmail_cli():
    """Gmail CLI command base. Override with GMAIL_CLI in config.env.
    Expected interface: <cmd> gmail +triage --query Q --max N --format json
    and <cmd> gmail +read --id ID --format json, both emitting JSON."""
    return shlex.split(CFG.get("GMAIL_CLI", "hatch_gws_cli"))


def gmail_triage(query, maxn=5):
    try:
        r = subprocess.run(
            gmail_cli() + ["gmail", "+triage", "--query", query,
                           "--max", str(maxn), "--format", "json"],
            capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        print("gmail CLI not found ({}). Set GMAIL_CLI in config.env "
              "to a tool providing 'gmail +triage/+read --format json'."
              .format(CFG.get("GMAIL_CLI", "hatch_gws_cli")),
              file=sys.stderr)
        return []
    data = json.loads(r.stdout)
    return data.get("messages", [])


def gmail_read(msg_id):
    r = subprocess.run(
        gmail_cli() + ["gmail", "+read", "--id", msg_id, "--format", "json"],
        capture_output=True, text=True, timeout=60)
    return json.loads(r.stdout)


def cmd_gcode(args):
    query = "({}) newer_than:{}m".format(args.query, args.mins)
    msgs = gmail_triage(query)
    if not msgs:
        print("no messages for: {}".format(query), file=sys.stderr)
        return 1
    msg = gmail_read(msgs[0]["id"])
    code = extract_code(msg.get("subject"), msg.get("body_text"))
    if not code:
        print("no code found in newest message ({})".format(
            msg.get("subject")), file=sys.stderr)
        return 1
    # Transient only: printed for immediate use, never stored.
    print(code)
    return 0


# ------------------------------------------------- one-shot code entry flow

def wait_enabled_button(nodes, text, timeout=15):
    """Wait until a button matching text is present AND enabled."""
    deadline = time.time() + timeout
    while True:
        hits = find_nodes(nodes, text, exact=True)
        btns = [n for n in hits
                if n["clickable"] and n["enabled"] and n["center"][0] is not None]
        if btns:
            return btns[0]
        if time.time() > deadline:
            return None
        time.sleep(2)
        nodes = walk(ui_dump())


def cmd_vcode(args):
    """End-to-end: wait for a code field, pull the email code, type it, submit."""
    print("waiting for code field...", flush=True)
    deadline = time.time() + args.timeout
    field = None
    while time.time() < deadline:
        nodes = walk(ui_dump())
        edits = [n for n in nodes if n["class"].endswith("EditText")]
        if edits:
            field = edits[0]
            break
        time.sleep(2)
    if field is None:
        print("no code field appeared", file=sys.stderr)
        return 1

    msgs = gmail_triage("({}) newer_than:{}m".format(args.query, args.mins))
    if not msgs:
        print("no code email found", file=sys.stderr)
        return 1
    msg = gmail_read(msgs[0]["id"])
    code = extract_code(msg.get("subject"), msg.get("body_text"))
    if not code:
        print("no code in newest email", file=sys.stderr)
        return 1
    print("code pulled ({} chars), typing...".format(len(code)), flush=True)

    xy = clickable_target(field)
    tap_center(*xy)
    time.sleep(0.8)
    for _ in range(20):
        adb_or_ensure("shell", "input", "keyevent", "67")
    time.sleep(0.5)
    for ch in code:
        adb_or_ensure("shell", "input", "text", esc_char(ch))
        time.sleep(0.25)
    u2_invalidate()

    print("waiting for '{}' button...".format(args.submit), flush=True)
    btn = wait_enabled_button(walk(ui_dump()), args.submit, timeout=20)
    if btn is None:
        print("submit button never enabled", file=sys.stderr)
        return 1
    bxy = clickable_target(btn)
    tap_center(*bxy)
    print("submitted", flush=True)
    return 0


# ------------------------------------------------------------------ doctor

def _doctor_check(name, fn, fix=None):
    """Run one doctor check, catching everything. Returns a
    {"name":..., "ok":..., "detail":..., "fix":...} dict. The fix hint tells
    the user how to resolve a failure (app-automating check_environment pattern)."""
    try:
        ok, detail = fn()
    except Exception as e:
        ok, detail = False, "{}: {}".format(type(e).__name__, e)
    return {"name": name, "ok": bool(ok), "detail": str(detail),
            "fix": fix}


def cmd_doctor(args):
    """Run connectivity/health checks and summarize. Exit 0 iff all pass."""
    checks = []
    latency_ms = None

    def check_adb_binary():
        r = subprocess.run([ADB_BIN, "version"], capture_output=True,
                           text=True, timeout=10)
        if r.returncode != 0:
            return False, "adb version failed: {}".format((r.stderr or "").strip()[:120])
        line = (r.stdout or "").strip().splitlines()
        return True, line[0] if line else "ok"

    def check_adb_server():
        r = subprocess.run([ADB_BIN, "devices"], capture_output=True,
                           text=True, timeout=15)
        if r.returncode != 0:
            return False, (r.stderr or "").strip()[:120] or "no response"
        return True, "server responded"

    def check_tunnel():
        r = subprocess.run([ADB_BIN, "connect", TARGET], capture_output=True,
                           text=True, timeout=20)
        out = ((r.stdout or "") + " " + (r.stderr or "")).strip()
        low = out.lower()
        ok = "connected" in low and "failed" not in low \
            and "cannot" not in low and "refused" not in low
        return ok, out.splitlines()[0][:120] if out else "no output"

    def check_u2_daemon():
        if not os.path.exists(U2_SOCK) or u2sock("health", timeout=10) is None:
            # Not running, e.g. just after an update stopped it. u2ctl starts
            # it on demand, so start it here rather than reporting a failure.
            u2ctl("health", timeout=60)
        if not os.path.exists(U2_SOCK):
            return False, "socket missing: {}".format(U2_SOCK)
        r = u2sock("health", timeout=10)
        return (r is not None,
                "daemon answered health" if r is not None else "no reply to health")

    def check_device_state():
        r = adb("get-state", timeout=10)
        st = (r.stdout or "").strip()
        return st == "device", "state={}".format(st or "none")

    def check_dump_pipeline():
        root = fast_dump()
        if root is None:
            return False, "fast_dump returned nothing"
        return True, "{} nodes".format(len(walk(root)))

    checks.append(_doctor_check(
        "adb binary", check_adb_binary,
        fix="Run ./install.sh to download platform-tools to .android-tools/"))
    checks.append(_doctor_check(
        "adb server", check_adb_server,
        fix="Run `burner ensure` to restart the adb server"))
    checks.append(_doctor_check(
        "tunnel target", check_tunnel,
        fix="Check config.env ADB_PORT matches the phone's Wireless debugging "
            "screen; run ./tunnel.sh start; ensure Tailscale is connected on the phone"))
    checks.append(_doctor_check(
        "u2 daemon", check_u2_daemon,
        fix="Run `burner ensure` to restart the u2 daemon (~5s)"))
    checks.append(_doctor_check(
        "device state", check_device_state,
        fix="If 'unauthorized', re-run pairing (fresh code from phone). "
            "If 'offline', run `adb kill-server` then `burner ensure`"))
    checks.append(_doctor_check(
        "dump pipeline", check_dump_pipeline,
        fix="Keep the phone screen awake (charger + `svc power stayon true`); "
            "run `burner ensure` to restart the u2 stack"))

    # Latency: one cached dump round-trip through the daemon socket.
    t0 = time.time()
    try:
        xml = u2sock("dump", timeout=40)
        latency_ms = int((time.time() - t0) * 1000)
        if xml and ("<hierarchy" in xml or "<?xml" in xml):
            checks.append({"name": "latency", "ok": True,
                           "detail": "cached dump round-trip: {} ms".format(latency_ms)})
        else:
            checks.append({"name": "latency", "ok": False,
                           "detail": "dump call failed after {} ms".format(latency_ms)})
    except Exception as e:
        latency_ms = int((time.time() - t0) * 1000)
        checks.append({"name": "latency", "ok": False,
                       "detail": "{}: {}".format(type(e).__name__, e)})

    allok = all(c["ok"] for c in checks)
    if as_json(args):
        print(json.dumps({"ok": allok, "checks": checks,
                          "latency_ms": latency_ms}))
    else:
        print("doctor: {}/{} checks passed".format(
            sum(1 for c in checks if c["ok"]), len(checks)))
        for c in checks:
            print("  [{}] {}: {}".format("ok" if c["ok"] else "FAIL",
                                         c["name"], c["detail"]))
            if not c["ok"] and c.get("fix"):
                print("        fix: {}".format(c["fix"]))
        if not allok:
            print("run `burner ensure` to heal the tunnel, adb server, and daemons",
                  file=sys.stderr)
    return 0 if allok else 1


# ------------------------------------------------------- navigation memory
"""
Navigation memory: a SQLite transition graph of screens the agent has visited.

Inspired by app-automating's navigation_memory module (MIT). Every interaction
is recorded as (from_screen, action, to_screen, ok) so the agent can ask
"how do I get to the Checkout screen?" instead of rediscovering routes.

PRIVACY POLICY (explicit, from app-automating):
- Typed text is NEVER recorded. Only the fact that "a field was filled" is
  stored, never the content. Passwords, card numbers, and messages stay on
  the device.
- Screenshots are never stored in the database.
- The database is local-only (~/.cache/burner/nav-memory.db), never synced.

Screens are fingerprinted by STRUCTURE (see screen_fingerprint), not content,
so a cart with 2 items and the same cart with 3 items are the same node.
"""

NAV_DB = os.path.join(os.path.expanduser("~"), ".cache", "burner", "nav-memory.db")


def nav_init():
    """Create the navigation memory tables if they don't exist."""
    import sqlite3
    os.makedirs(os.path.dirname(NAV_DB), exist_ok=True)
    con = sqlite3.connect(NAV_DB)
    try:
        con.execute("""
            CREATE TABLE IF NOT EXISTS screen (
                fingerprint TEXT PRIMARY KEY,
                first_seen REAL NOT NULL,
                last_seen REAL NOT NULL,
                label TEXT
            )
        """)
        con.execute("""
            CREATE TABLE IF NOT EXISTS transition (
                from_fp TEXT NOT NULL,
                action TEXT NOT NULL,
                to_fp TEXT,
                ok INTEGER NOT NULL DEFAULT 1,
                count INTEGER NOT NULL DEFAULT 1,
                last_used REAL NOT NULL,
                PRIMARY KEY (from_fp, action, to_fp)
            )
        """)
        con.execute("""
            CREATE TABLE IF NOT EXISTS run (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                started_at REAL NOT NULL
            )
        """)
        con.execute("""
            CREATE TABLE IF NOT EXISTS step (
                run_id INTEGER NOT NULL,
                seq INTEGER NOT NULL,
                from_fp TEXT,
                action TEXT NOT NULL,
                to_fp TEXT,
                ok INTEGER NOT NULL DEFAULT 1,
                PRIMARY KEY (run_id, seq)
            )
        """)
        con.commit()
    finally:
        con.close()


def nav_record_screen(fingerprint, label=None):
    """Record a screen visit (upsert). Never raises."""
    import sqlite3
    try:
        nav_init()
        now = time.time()
        con = sqlite3.connect(NAV_DB)
        try:
            cur = con.execute("SELECT fingerprint FROM screen WHERE fingerprint = ?",
                              (fingerprint,))
            if cur.fetchone():
                con.execute("UPDATE screen SET last_seen = ?, label = COALESCE(?, label) "
                            "WHERE fingerprint = ?",
                            (now, label, fingerprint))
            else:
                con.execute("INSERT INTO screen (fingerprint, first_seen, last_seen, label) "
                            "VALUES (?, ?, ?, ?)",
                            (fingerprint, now, now, label))
            con.commit()
        finally:
            con.close()
    except Exception:
        pass


def nav_record(from_fp, action, to_fp, ok=True):
    """Record a transition (from_screen, action, to_screen, ok).

    Failed gestures are recorded too (ok=False): "tapping this here does
    nothing" is knowledge. Typed text content is NEVER recorded — the action
    string for type operations is "type <field-hint>" or "type", never the
    actual text.
    """
    import sqlite3
    try:
        nav_init()
        now = time.time()
        # Record both screens (skip if fingerprint is None)
        if from_fp:
            nav_record_screen(from_fp)
        if to_fp:
            nav_record_screen(to_fp)
        con = sqlite3.connect(NAV_DB)
        try:
            # Upsert the transition: increment count, update ok and last_used
            # Handle NULL from_fp/to_fp in the WHERE clause
            cur = con.execute(
                "SELECT count FROM transition "
                "WHERE ((from_fp = ?) OR (from_fp IS NULL AND ? IS NULL)) "
                "AND action = ? AND "
                "((to_fp = ?) OR (to_fp IS NULL AND ? IS NULL))",
                (from_fp, from_fp, action, to_fp, to_fp))
            row = cur.fetchone()
            if row:
                con.execute(
                    "UPDATE transition SET count = count + 1, ok = ?, last_used = ? "
                    "WHERE ((from_fp = ?) OR (from_fp IS NULL AND ? IS NULL)) "
                    "AND action = ? AND "
                    "((to_fp = ?) OR (to_fp IS NULL AND ? IS NULL))",
                    (1 if ok else 0, now, from_fp, from_fp, action, to_fp, to_fp))
            else:
                con.execute(
                    "INSERT INTO transition (from_fp, action, to_fp, ok, count, last_used) "
                    "VALUES (?, ?, ?, ?, 1, ?)",
                    (from_fp, action, to_fp, 1 if ok else 0, now))
            con.commit()
        finally:
            con.close()
    except Exception:
        pass


def nav_whereami(fingerprint):
    """Get info about a screen fingerprint. Returns dict or None."""
    import sqlite3
    try:
        nav_init()
        con = sqlite3.connect(NAV_DB)
        try:
            cur = con.execute(
                "SELECT fingerprint, first_seen, last_seen, label FROM screen "
                "WHERE fingerprint = ?", (fingerprint,))
            row = cur.fetchone()
            if not row:
                return None
            # Get outgoing transitions
            cur = con.execute(
                "SELECT action, to_fp, ok, count FROM transition "
                "WHERE from_fp = ? ORDER BY count DESC LIMIT 20",
                (fingerprint,))
            transitions = [{"action": r[0], "to_fp": r[1], "ok": bool(r[2]), "count": r[3]}
                           for r in cur.fetchall()]
            return {
                "fingerprint": row[0],
                "first_seen": row[1],
                "last_seen": row[2],
                "label": row[3],
                "transitions": transitions,
            }
        finally:
            con.close()
    except Exception:
        return None


def nav_route(from_fp, target_label, max_hops=10):
    """Best-first search from from_fp to a screen containing target_label.

    Scored by edge reliability (success rate), ties broken by fewer hops.
    Returns a list of (action, to_fp) tuples, or None if no route found.
    """
    import sqlite3
    import heapq
    try:
        nav_init()
        con = sqlite3.connect(NAV_DB)
        try:
            # Find target screens containing the label
            # Label matching: check screen labels and transition actions
            cur = con.execute("SELECT fingerprint, label FROM screen")
            targets = set()
            for fp, label in cur.fetchall():
                if label and target_label.lower() in label.lower():
                    targets.add(fp)
            # Also check if any transition action mentions the label
            # (actions like 'tap "Checkout"' contain the label)
            cur = con.execute(
                "SELECT DISTINCT to_fp FROM transition WHERE to_fp IS NOT NULL")
            for (to_fp,) in cur.fetchall():
                if to_fp:
                    # Get the screen label
                    cur2 = con.execute("SELECT label FROM screen WHERE fingerprint = ?",
                                       (to_fp,))
                    row = cur2.fetchone()
                    if row and row[0] and target_label.lower() in row[0].lower():
                        targets.add(to_fp)
            if not targets:
                return None

            # Best-first search: (negative_reliability, hops, fp, path)
            # Reliability = product of edge success rates along path
            visited = {from_fp: 1.0}
            heap = [(-1.0, 0, from_fp, [])]
            while heap:
                neg_rel, hops, fp, path = heapq.heappop(heap)
                rel = -neg_rel
                if fp in targets:
                    return path
                if hops >= max_hops:
                    continue
                cur = con.execute(
                    "SELECT action, to_fp, ok, count FROM transition "
                    "WHERE from_fp = ? AND to_fp IS NOT NULL",
                    (fp,))
                for action, to_fp, ok, count in cur.fetchall():
                    if not to_fp or to_fp in visited:
                        continue
                    # Edge reliability: ok (1 or 0) weighted by count
                    # Simple: if ok=1, reliability=0.9 + 0.1*min(count,10)/10
                    # If ok=0, reliability=0.1 (might work this time)
                    edge_rel = (0.9 + 0.1 * min(count, 10) / 10) if ok else 0.1
                    new_rel = rel * edge_rel
                    # Only visit if this path is better than previous
                    if to_fp not in visited or new_rel > visited[to_fp]:
                        visited[to_fp] = new_rel
                        new_path = path + [(action, to_fp)]
                        heapq.heappush(heap, (-new_rel, hops + 1, to_fp, new_path))
            return None
        finally:
            con.close()
    except Exception:
        return None


def nav_forget():
    """Clear all navigation memory. Returns True on success."""
    import sqlite3
    try:
        if os.path.exists(NAV_DB):
            os.remove(NAV_DB)
        return True
    except Exception:
        return False


def cmd_whereami(args):
    """Show current screen fingerprint and known transitions."""
    root = ui_dump()
    nodes = walk(root)
    fp = screen_fingerprint(nodes)
    info = nav_whereami(fp)
    if as_json(args):
        print(json.dumps({"ok": True, "fingerprint": fp, "info": info}))
        return 0
    print("fingerprint: {}".format(fp))
    if not info:
        print("unknown screen (not in navigation memory yet)")
        print("visit it via tap/press/type to start building the map")
        return 0
    print("first seen: {}".format(time.strftime("%Y-%m-%d %H:%M",
                                                time.localtime(info["first_seen"]))))
    print("last seen: {}".format(time.strftime("%Y-%m-%d %H:%M",
                                               time.localtime(info["last_seen"]))))
    if info["label"]:
        print("label: {}".format(info["label"]))
    if info["transitions"]:
        print("known actions from here ({}):".format(len(info["transitions"])))
        for t in info["transitions"][:10]:
            status = "ok" if t["ok"] else "FAILED"
            print("  - {} -> {} [{} x{}]".format(
                t["action"], (t["to_fp"] or "?")[:12], status, t["count"]))
    else:
        print("no recorded actions from this screen yet")
    return 0


def cmd_route(args):
    """Find a route to a screen containing the target label."""
    root = ui_dump()
    nodes = walk(root)
    from_fp = screen_fingerprint(nodes)
    route = nav_route(from_fp, args.target)
    if as_json(args):
        print(json.dumps({"ok": route is not None, "route": route}))
        return 0 if route else 1
    if not route:
        print('no route found to "{}" from current screen'.format(args.target))
        print("the navigation memory may not have seen that screen yet")
        return 1
    print('route to "{}" ({} steps):'.format(args.target, len(route)))
    for i, (action, to_fp) in enumerate(route, 1):
        print("  {}. {} -> {}".format(i, action, to_fp[:12]))
    return 0


def cmd_forget(args):
    """Clear navigation memory (with confirmation unless --yes)."""
    if not args.yes:
        print("this will delete all navigation memory ({} screens, transitions, runs)".format(
            "all"))
        print("run with --yes to confirm")
        return 1
    if nav_forget():
        print("navigation memory cleared")
        return 0
    print("failed to clear navigation memory", file=sys.stderr)
    return 1


# ------------------------------------------------------------------- main

def _scroll_swipe(direction):
    w, h = screen_dims()
    cx, cy = w // 2, h // 2
    dx, dy = w * 3 // 10, h * 3 // 10
    x1, y1, x2, y2 = {
        "down": (cx, cy + dy, cx, cy - dy),
        "up": (cx, cy - dy, cx, cy + dy),
        "right": (cx + dx, cy, cx - dx, cy),
        "left": (cx - dx, cy, cx + dx, cy),
    }[direction]
    # Never start or end a swipe on an edge or off the screen: that opens the
    # shade or app drawer, goes Home, or becomes a tap.
    def clamp(v, hi):
        return max(int(hi * 0.05), min(int(hi * 0.95), v))
    x1, x2 = clamp(x1, w), clamp(x2, w)
    y1, y2 = clamp(y1, h), clamp(y2, h)
    wake()
    if os.environ.get("BURNER_DEBUG"):
        print("swipe {},{} -> {},{} on a {}x{} screen".format(
            x1, y1, x2, y2, w, h), file=sys.stderr)
    adb_or_ensure("shell", "input", "swipe", x1, y1, x2, y2, 350)
    u2_invalidate()
    time.sleep(0.6)


def _scroll_to_end(direction, max_scrolls=15):
    """Scroll the current app until the screen stops changing. Stays in the
    app: swipes start mid-screen, never from an edge (which would open the
    notification shade or app drawer)."""
    root = ui_dump()
    pkg = dump_package(root)
    before = visible_lines(walk(root))
    for n in range(1, max_scrolls + 1):
        _scroll_swipe(direction)
        root = ui_dump()
        if pkg and dump_package(root) not in (None, pkg):
            print("scroll left {} (now in {}); stopped.".format(
                pkg, dump_package(root)), file=sys.stderr)
            return 1
        after = visible_lines(walk(root))
        if after == before:
            print("at the {}".format("top" if direction == "up" else "bottom"))
            return 0
        before = after
    print("still moving after {} scrolls".format(max_scrolls))
    return 0


def focused_package_fast():
    """Package in front, from one small adb call (no UI dump). None if unknown."""
    r = adb("shell", "dumpsys window | grep mCurrentFocus", timeout=20)
    m = re.search(r"mCurrentFocus=.*?\s([\w.]+)/", r.stdout or "")
    return m.group(1) if m else None


def cmd_scroll(args):
    """Scroll like a finger would. `down` reveals content below (the finger
    swipes up). With --to, stop as soon as the text is visible."""
    if args.direction in ("top", "bottom"):
        return _scroll_to_end("up" if args.direction == "top" else "down")
    times = args.times if (args.times != 1 or not args.to) else 10
    root = ui_dump()  # also refreshes the screen size
    pkg = dump_package(root)
    for i in range(times + 1):
        if args.to and find_nodes(walk(root), args.to, exact=False):
            print("found: {}".format(args.to))
            return 0
        if i == times:
            break
        _scroll_swipe(args.direction)
        # Looking for text needs a fresh dump each time. A plain scroll only
        # needs to know the app is still in front, which is much cheaper.
        if args.to:
            root = ui_dump()
            now = dump_package(root)
        else:
            now = focused_package_fast()
        if pkg and now not in (None, pkg):
            print("scroll left {} (now in {}); stopped.".format(pkg, now),
                  file=sys.stderr)
            return 1
    if args.to:
        print("not found after {} scrolls: {}".format(times, args.to),
              file=sys.stderr)
        return 1
    print("scrolled {} x{}".format(args.direction, times))
    return 0


# Labels that close a pop-up without agreeing to anything, safest first.
DISMISS_LABELS = ["not now", "no thanks", "no, thanks", "maybe later", "skip",
                  "later", "don't allow", "deny", "dismiss", "got it", "close"]


def pick_dismiss(nodes):
    """The node to tap to close a pop-up, or None. Prefers the safest label
    (Not now, No thanks, Skip... Don't allow, then Got it and Close).
    Pure function: no adb, unit-testable."""
    for label in DISMISS_LABELS:
        for n in nodes:
            text = (n.get("text") or n.get("desc") or "").strip().lower()
            if text == label and n.get("center", (None,))[0] is not None:
                return n
    return None


def cmd_dismiss(args):
    """Close pop-ups that get in the way: permission asks, 'Got it' tips,
    upsells. Taps only close-without-agreeing labels, never OK/Allow/Accept.
    Prints what it closed so the user can be told."""
    closed = []
    for _ in range(max(1, args.max)):
        node = pick_dismiss(walk(ui_dump()))
        if node is None:
            break
        x, y = clickable_target(node)
        tap_center(x, y)
        closed.append(node.get("text") or node.get("desc"))
        time.sleep(1.2)
    if closed:
        print("closed: {}".format(", ".join(closed)))
    else:
        print("nothing to close")
    return 0


def cmd_apps(args):
    """List installed app packages, so the agent can prefer an installed app
    over a website. Exit 1 if a match was asked for and nothing matched."""
    cmd = ["shell", "pm", "list", "packages"] + ([] if args.all else ["-3"])
    r = adb_or_ensure(*cmd, timeout=30)
    pkgs = sorted(l.split(":", 1)[1].strip()
                  for l in (r.stdout or "").splitlines() if l.startswith("package:"))
    if args.match:
        pkgs = [p for p in pkgs if args.match.lower() in p.lower()]
    for p in pkgs:
        print(p)
    return 0 if (pkgs or not args.match) else 1


def cmd_open(args):
    cmd = ["shell", "am", "start", "-a", "android.intent.action.VIEW",
           "-d", args.url]
    # A trailing package targets the intent, skipping the "Open with" chooser
    # when several apps claim the link (e.g. Play Store and Aurora Store).
    if args.package:
        cmd.append(args.package)
    adb_or_ensure(*cmd)
    u2_invalidate()
    print("opened {}".format(args.url))
    return 0


def cmd_amazon_status(args):
    """One-shot: latest Amazon order status from the app's order list.
    Stops at the list (no detail-page drill-in). Each step runs as a fresh
    burner subprocess — the Amazon WebView only exposes its nodes to a new
    u2 session after a scroll, and in-process reuse returns stale trees."""
    import re
    import subprocess
    pc_bin = os.path.join(ROOT, "bin", "burner")

    def run(*a):
        r = subprocess.run([pc_bin] + [str(x) for x in a],
                           capture_output=True, text=True, timeout=90)
        return r.stdout or ""

    run("open", "https://www.amazon.com/gp/css/order-history",
        "com.amazon.mShop.android.shopping")  # the app, not a browser
    time.sleep(8)
    # scroll once to force the WebView to expose order nodes
    subprocess.run([ADB_BIN, "-s", TARGET, "shell", "input", "swipe",
                    "1200", "800", "1200", "300", "200"],
                   capture_output=True, timeout=30)
    time.sleep(3)
    order_re = re.compile(
        r"(.+?), Order placed (.+?), (Delivered|Shipped|Arriving|Out for delivery)([^.]*\.?)",
        re.IGNORECASE)
    for _ in range(3):
        out = run("dump")
        for line in out.splitlines():
            m = order_re.search(line)
            if m and "Buy again" not in line:
                item, placed, status, extra = m.groups()
                item = item.lstrip("[").strip()
                item = item[:55] + "..." if len(item) > 55 else item
                detail = (extra or "").strip().rstrip(".")
                print("{}".format(item))
                print("{} — ordered {}".format(status, placed)
                      + (" ({})".format(detail) if detail else ""))
                return 0
        subprocess.run([ADB_BIN, "-s", TARGET, "shell", "input", "swipe",
                        "1200", "800", "1200", "300", "200"],
                       capture_output=True, timeout=30)
        time.sleep(2)
    print("no orders found", file=sys.stderr)
    return 1


def cmd_sleep(args):
    time.sleep(args.seconds)
    return 0


def build_parser():
    ap = argparse.ArgumentParser(prog="burner", description="phone control CLI")
    ap.add_argument("--json", action="store_true",
                    help="machine-readable JSON on stdout (errors stay human on stderr)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("dump", help="list visible UI texts + bounds")
    p.add_argument("--all", action="store_true", help="include empty-text nodes")
    p.add_argument("--verbose", action="store_true",
                   help="legacy full format (label [Class] [x1,y1][x2,y2])")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON on stdout")
    p.set_defaults(fn=cmd_dump)

    p = sub.add_parser("snap", help="numbered UI snapshot (@e1..@eN handles for tap)")
    p.add_argument("--all", action="store_true", help="include empty-text nodes")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON on stdout")
    p.set_defaults(fn=cmd_snap)

    p = sub.add_parser("tap", help="tap node by text (or --xy normalized coords)")
    p.add_argument("text", nargs="?", default=None,
                   help='node text to tap (omit with --xy); "@eN" taps a burner snap handle; '
                        '"a || b" tries fallback labels in order')
    p.add_argument("--fuzzy", action="store_true")
    p.add_argument("--index", type=int, default=None,
                   help="which match to tap (required when the label is ambiguous)")
    p.add_argument("--xy", metavar="X,Y",
                   help="normalized 0.0-1.0 coordinates, e.g. --xy 0.5,0.8")
    p.add_argument("--no-occlusion-check", action="store_true",
                   help="skip the occlusion check (faster when you know it's safe)")
    p.add_argument("--settle", action="store_true",
                   help="after tapping, wait for the screen to stop changing "
                        "and show what appeared/disappeared")
    p.add_argument("--no-evidence", action="store_true",
                   help="skip screenshot+dump capture on failure")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON on stdout")
    p.set_defaults(fn=cmd_tap)

    p = sub.add_parser("wait", help="wait for text to appear (or vanish)")
    p.add_argument("text")
    p.add_argument("--timeout", type=int, default=30)
    p.add_argument("--fuzzy", action="store_true")
    p.add_argument("--absent", action="store_true",
                   help="wait until the text disappears")
    p.add_argument("--no-evidence", action="store_true",
                   help="skip screenshot+dump capture on failure")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON on stdout")
    p.set_defaults(fn=cmd_wait)

    p = sub.add_parser("type", help="type text (auto ADBKeyboard route for non-ASCII)")
    p.add_argument("text")
    p.add_argument("--field", help="tap this text first to focus its field")
    p.add_argument("--clear", action="store_true")
    p.add_argument("--clear-keys", type=int, default=20)
    p.add_argument("--slow", action="store_true", help="0.4s between chars")
    p.add_argument("--unicode", action="store_true",
                   help="force the ADBKeyboard route even for ASCII text")
    p.add_argument("--ascii", action="store_true",
                   help="force the legacy path even for non-ASCII text")
    p.set_defaults(fn=cmd_type)

    p = sub.add_parser("scroll", help="scroll the screen (down shows more below)")
    p.add_argument("direction", nargs="?", default="down",
                   choices=["down", "up", "left", "right", "top", "bottom"])
    p.add_argument("--times", type=int, default=1, help="how many scrolls")
    p.add_argument("--to", metavar="TEXT",
                   help="keep scrolling until TEXT is on screen (max --times, "
                        "default 10)")
    p.set_defaults(fn=cmd_scroll)

    p = sub.add_parser("press", help="keyevent (BACK, HOME, 224, 67, ...)")
    p.add_argument("key")
    p.add_argument("--repeat", type=int, default=1,
                   help="repeat the keypress N times (e.g. --repeat 5 for backspace x5)")
    p.add_argument("--delay", type=int, default=120,
                   help="ms between repeats (default 120)")
    p.add_argument("--ctrl", action="store_true", help="hold Ctrl (KEYCODE_CTRL_LEFT)")
    p.add_argument("--shift", action="store_true", help="hold Shift (KEYCODE_SHIFT_LEFT)")
    p.add_argument("--alt", action="store_true", help="hold Alt (KEYCODE_ALT_LEFT)")
    p.add_argument("--meta", action="store_true", help="hold Meta/Win (KEYCODE_META_LEFT)")
    p.set_defaults(fn=cmd_press)

    p = sub.add_parser("status", help="is the phone up? battery, charging, screen, apps")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON on stdout")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("state", help="focused app + top screen texts")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON on stdout")
    p.set_defaults(fn=cmd_state)

    p = sub.add_parser("dismiss", help="close pop-ups (Not now, Skip, Don't allow...)")
    p.add_argument("--max", type=int, default=4,
                   help="most pop-ups to close in a row (default 4)")
    p.set_defaults(fn=cmd_dismiss)

    p = sub.add_parser("apps", help="list apps installed on the phone")
    p.add_argument("match", nargs="?",
                   help="only apps whose package name contains this (e.g. amazon)")
    p.add_argument("--all", action="store_true",
                   help="include system apps, not just ones the user installed")
    p.set_defaults(fn=cmd_apps)

    p = sub.add_parser("start", help="launch app by package")
    p.add_argument("package")
    p.set_defaults(fn=cmd_start)

    p = sub.add_parser("shot", help="screenshot via screenshot.sh")
    p.add_argument("--out", metavar="PATH",
                   help="save here instead of shots/; a folder gets a new "
                        "timestamped file each time (e.g. --out .)")
    p.set_defaults(fn=cmd_shot)

    p = sub.add_parser("ensure", help="tunnel + adb connect check")
    p.set_defaults(fn=lambda a: 0 if ensure() else 1)

    p = sub.add_parser("gcode", help="pull newest verification code from Gmail")
    p.add_argument("--from", dest="query", required=True,
                   help="triage query, e.g. 'from:security@example.com'")
    p.add_argument("--mins", type=int, default=15)
    p.set_defaults(fn=cmd_gcode)

    p = sub.add_parser("vcode", help="one-shot: wait for code field, pull email code, type, submit")
    p.add_argument("--from", dest="query", required=True)
    p.add_argument("--mins", type=int, default=15)
    p.add_argument("--timeout", type=int, default=60,
                   help="how long to wait for the code field")
    p.add_argument("--submit", default="Continue", help="submit button text")
    p.set_defaults(fn=cmd_vcode)

    p = sub.add_parser("open", help="open URL/deep link via VIEW intent")
    p.add_argument("url")
    p.add_argument("package", nargs="?", default=None,
                   help="app package to handle the link (skips the chooser)")
    p.set_defaults(fn=cmd_open)

    p = sub.add_parser("sleep", help="sleep N seconds (for use in 'do')")
    p.add_argument("seconds", type=float)
    p.set_defaults(fn=cmd_sleep)

    p = sub.add_parser("do",
                       help='run a ;-separated flow in one call, e.g. burner do \'open URL; wait "X" --timeout 20\'')
    p.add_argument("flow")
    p.set_defaults(fn=cmd_do)

    p = sub.add_parser("recipe", help="run a saved flow from recipes/<name>.burner")
    p.add_argument("name")
    p.set_defaults(fn=cmd_recipe)

    p = sub.add_parser("record", help="record actions to recipes/<name>.burner")
    p.add_argument("name", nargs="?", default=None,
                   help="recipe name (omit with --stop)")
    p.add_argument("--stop", action="store_true",
                   help="stop the active recording")
    p.add_argument("--force", action="store_true",
                   help="overwrite existing recipe")
    p.set_defaults(fn=cmd_record)

    p = sub.add_parser("replay", help="replay a recorded session")
    p.add_argument("name")
    p.set_defaults(fn=cmd_replay)

    p = sub.add_parser("amazon-status",
                       help="latest Amazon order status (one-shot, stops at order list)")
    p.set_defaults(fn=cmd_amazon_status)

    p = sub.add_parser("doctor", help="run connectivity/health checks")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON on stdout")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("whereami", help="show current screen fingerprint + known transitions")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON on stdout")
    p.set_defaults(fn=cmd_whereami)

    p = sub.add_parser("route", help="find a route to a screen (via navigation memory)")
    p.add_argument("target", help="label to route to (e.g. \"Checkout\")")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON on stdout")
    p.set_defaults(fn=cmd_route)

    p = sub.add_parser("forget", help="clear navigation memory")
    p.add_argument("--yes", action="store_true",
                   help="confirm deletion without prompting")
    p.set_defaults(fn=cmd_forget)

    p = sub.add_parser("setup", help="guided phone setup wizard")
    p.add_argument("--list-steps", action="store_true",
                   help="list setup steps with their status")
    p.add_argument("--step", metavar="NAME",
                   help="run a single step non-interactively")
    p.add_argument("--confirm", action="store_true",
                   help="record a human step as done (with --step)")
    p.add_argument("--yes", action="store_true",
                   help="auto-confirm agent actions")
    p.add_argument("--code", metavar="CODE",
                   help="6-digit pairing code (pair step; never stored)")
    p.add_argument("--ip", metavar="IP",
                   help="phone tailnet IP from pairing dialog (pair step)")
    p.add_argument("--pair-port", metavar="PORT",
                   help="pairing port from pairing dialog (pair step)")
    p.add_argument("--connect-port", metavar="PORT",
                   help="wireless debugging port (pair step)")
    p.set_defaults(fn=cmd_setup)

    p = sub.add_parser("update", help="update burner and its recipes to the latest")
    p.add_argument("what", nargs="?", choices=["recipes"],
                   help="'recipes' to refresh only the built-in recipes")
    p.set_defaults(fn=cmd_update)

    p = sub.add_parser("uninstall", help="undo the phone changes burner setup made")
    p.add_argument("--yes", action="store_true",
                   help="actually do it (without it, only list the changes)")
    p.set_defaults(fn=cmd_uninstall)

    return ap


def cmd_do(args):
    ap = build_parser()
    steps = [s.strip() for s in args.flow.split(";") if s.strip()]
    for i, step in enumerate(steps, 1):
        try:
            ns = ap.parse_args(shlex.split(step))
        except SystemExit:
            print("do: bad step {}: {}".format(i, step), file=sys.stderr)
            return 1
        print("do [{}]: {}".format(i, step), flush=True)
        rc = ns.fn(ns)
        if rc:
            print("do: step {} failed, stopping".format(i), file=sys.stderr)
            return rc
    return 0


def cmd_recipe(args):
    path = os.path.join(ROOT, "recipes", args.name + ".burner")
    if not os.path.exists(path):
        print("no recipe: {}".format(path), file=sys.stderr)
        return 1
    # $VAR / ${VAR} in steps expand from the environment, so one recipe can
    # take parameters: PLAY_PACKAGE=com.example.app burner recipe play-install
    steps = []
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                line = os.path.expandvars(line)
                unset = re.search(r"\$\{?([A-Za-z_]\w*)", line)
                if unset:
                    print("recipe {}: ${} is not set".format(args.name, unset.group(1)),
                          file=sys.stderr)
                    return 1
                steps.append(line)
    return cmd_do(argparse.Namespace(flow="; ".join(steps)))


# ------------------------------------------------------- record / replay
"""
Session recording: `burner record <name>` captures every action command to
recipes/<name>.burner, which can be replayed with `burner replay <name>`.

Recording captures the actual commands issued (tap, press, type, wait, start,
open), not just outcomes. The recipe file is a plain text list of burner
subcommands, human-readable and editable.
"""

RECORD_STATE = os.path.join(os.path.expanduser("~"), ".cache", "burner", "recording.json")


def record_active():
    """Check if recording is active. Returns (name, path) or (None, None)."""
    try:
        if os.path.exists(RECORD_STATE):
            with open(RECORD_STATE) as f:
                st = json.load(f)
                return st.get("name"), st.get("path")
    except Exception:
        pass
    return None, None


def record_log(command_line):
    """Append a command to the active recording, if any. Never raises."""
    try:
        name, path = record_active()
        if not name or not path:
            return
        # Don't record the record command itself, or non-action commands
        # that would pollute the recipe (dump, snap, doctor, etc.)
        with open(path, "a") as f:
            f.write(command_line + "\n")
    except Exception:
        pass


def record_command_line(args):
    """Reconstruct the burner subcommand line from parsed args for recording.
    Returns the command string (without 'burner' prefix), or None if not recordable."""
    # Map of command -> how to reconstruct
    # We use sys.argv to get the original, stripping the 'burner' prefix
    try:
        argv = sys.argv[1:]  # skip 'burner'
        if not argv:
            return None
        # Skip non-action commands
        non_recordable = {"dump", "snap", "doctor", "state", "shot", "whereami",
                          "route", "forget", "record", "replay", "recipe", "do",
                          "ensure", "gcode", "vcode", "amazon-status", "setup",
                          "uninstall", "update", "apps", "status", "dismiss"}
        if argv[0] in non_recordable:
            return None
        # Reconstruct with proper quoting
        return " ".join(shlex.quote(a) for a in argv)
    except Exception:
        return None


def cmd_record(args):
    """Start or stop recording a session to recipes/<name>.burner."""
    if args.stop:
        name, path = record_active()
        if not name:
            print("not recording")
            return 0
        try:
            os.remove(RECORD_STATE)
        except OSError:
            pass
        print("stopped recording '{}' -> {}".format(name, path))
        return 0
    # Start recording
    name = args.name
    if not name:
        print("usage: burner record <name> | burner record --stop", file=sys.stderr)
        return 1
    # Check if already recording
    active_name, _ = record_active()
    if active_name:
        print("already recording '{}' (stop with `burner record --stop`)".format(active_name),
              file=sys.stderr)
        return 1
    path = os.path.join(ROOT, "recipes", name + ".burner")
    # Don't overwrite existing without --force
    if os.path.exists(path) and not args.force:
        print("recipe '{}' exists (use --force to overwrite)".format(name),
              file=sys.stderr)
        return 1
    # Initialize the file with a header
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("# Recorded session: {}\n".format(name))
        f.write("# Started: {}\n".format(time.strftime("%Y-%m-%d %H:%M:%S")))
    # Save recording state
    os.makedirs(os.path.dirname(RECORD_STATE), exist_ok=True)
    with open(RECORD_STATE, "w") as f:
        json.dump({"name": name, "path": path, "started": time.time()}, f)
    print("recording to '{}' (stop with `burner record --stop`)".format(path))
    return 0


def cmd_replay(args):
    """Replay a recorded session. Same as `burner recipe`, but with step-by-step output."""
    path = os.path.join(ROOT, "recipes", args.name + ".burner")
    if not os.path.exists(path):
        print("no recording: {}".format(path), file=sys.stderr)
        return 1
    steps = []
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                steps.append(line)
    print("replaying '{}' ({} steps)".format(args.name, len(steps)))
    return cmd_do(argparse.Namespace(flow="; ".join(steps)))


# ------------------------------------------------------- setup wizard
"""
Guided phone setup: `burner setup` walks a human + agent through pairing a new
burner phone, step by step. Human steps print an instruction and a screenshot
path; the agent relays them in chat and records completion with
`burner setup --step <name> --confirm`. Agent steps run automatically.
Pairing codes are transient: passed on stdin to `adb pair`, never stored.
"""

SETUP_STATE_PATH = os.path.join(os.path.expanduser("~"), ".cache", "burner",
                                "setup-state.json")
SETUP_APK_CACHE = os.path.join(os.path.expanduser("~"), ".cache", "burner")
SETUP_APK_VERSION = "v0.3.5"
SETUP_APK_PKG = "com.tpn.adbautoenable"
SETUP_VPN_APP = "com.tailscale.ipn"
# Full URLs so chat apps can show them; the files also live in setup/.
SETUP_SHOTS = "https://useburner.si/setup/setup-{:02d}-{}.png"


def _setup_sh(*args, timeout=15):
    """Run an adb shell command, return stripped stdout or None on failure."""
    try:
        r = adb("shell", *args, timeout=timeout)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    return (r.stdout or "").strip() or None


def _setup_get_setting(namespace, key):
    v = _setup_sh("settings", "get", namespace, key)
    return v if v not in (None, "null") else None


def _setup_device_state():
    try:
        r = adb("get-state", timeout=10)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    return (r.stdout or "").strip() or None


def _setup_state_load():
    try:
        with open(SETUP_STATE_PATH) as f:
            st = json.load(f)
            if isinstance(st.get("done"), dict):
                return st
    except Exception:
        pass
    return {"done": {}}


def _setup_state_save(step):
    st = _setup_state_load()
    st["done"][step] = time.strftime("%Y-%m-%dT%H:%M:%S")
    try:
        os.makedirs(os.path.dirname(SETUP_STATE_PATH), exist_ok=True)
        with open(SETUP_STATE_PATH, "w") as f:
            json.dump(st, f, indent=2)
    except OSError as e:
        print("warning: could not save setup state: {}".format(e),
              file=sys.stderr)


def _setup_write_config(updates):
    """Update keys in config.env, preserving comments and other lines."""
    path = os.path.join(ROOT, "config.env")
    lines = []
    if os.path.exists(path):
        with open(path) as f:
            lines = f.readlines()
    seen = set()
    out = []
    for line in lines:
        s = line.strip()
        if s and not s.startswith("#") and "=" in s:
            k = s.split("=", 1)[0].strip()
            if k in updates:
                out.append('{}="{}"\n'.format(k, updates[k]))
                seen.add(k)
                continue
        out.append(line)
    for k, v in updates.items():
        if k not in seen:
            out.append('{}="{}"\n'.format(k, v))
    with open(path, "w") as f:
        f.writelines(out)
    global CFG, TARGET
    CFG = load_config()
    TARGET = "127.0.0.1:{}".format(CFG.get("LOCAL_PORT", "15555"))


def _setup_spawn(cmd, input_text=None, timeout=60):
    """Run a subprocess (socat, adb pair). Separate helper so tests can mock."""
    return subprocess.run(cmd, input=input_text, capture_output=True,
                          text=True, timeout=timeout)


def _setup_popen(cmd):
    """Start a background subprocess (tunnel). Separate helper for tests."""
    return subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)


def _setup_urlopen(url, timeout=60):
    """Fetch a URL, return bytes. Separate helper so tests can mock."""
    import urllib.request
    req = urllib.request.Request(url, headers={"User-Agent": "burner-setup"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


# --- step check functions: True=done, False=not done, None=cannot tell ---

def _check_prereqs():
    try:
        r = _setup_spawn([ADB_BIN, "version"], timeout=10)
    except Exception:
        return False
    return r.returncode == 0


def _setup_tailscale_status():
    try:
        r = _setup_spawn(["tailscale", "status", "--json"], timeout=15)
        return json.loads(r.stdout or "{}")
    except Exception:
        return None


def _check_tailnet():
    if _setup_device_state() == "device":
        return True  # the phone answers, however this computer gets there
    st = _setup_tailscale_status()
    if st is None:
        return None  # no Tailscale here (same-LAN setup) or can't tell
    return st.get("BackendState") == "Running"


def _run_tailnet(args):
    """Join this computer to the user's tailnet, surfacing the approval link."""
    if _check_tailnet():
        print("this computer is on your tailnet.")
        return 0
    if _setup_device_state() == "device":
        # Hosted assistants reach the phone through their host's tunnel
        # instead of a Tailscale client of their own: nothing to approve.
        print("this computer already reaches the phone; nothing to approve.")
        return 0
    if _setup_tailscale_status() is None:
        print("Tailscale isn't installed here. Install it, or put this "
              "computer on the same Wi-Fi as the phone.", file=sys.stderr)
        return 1
    _setup_popen(["tailscale", "up"])
    url = None
    for _ in range(20):
        st = _setup_tailscale_status() or {}
        if st.get("BackendState") == "Running":
            print("this computer is on your tailnet.")
            return 0
        url = st.get("AuthURL")
        if url:
            break
        time.sleep(1)
    if not url:
        print("Tailscale didn't give an approval link. Run `tailscale up` "
              "and send the user the link it prints.", file=sys.stderr)
        return 1
    print("APPROVAL NEEDED. Send the user this link as its own message, ask "
          "them to open it and approve this computer, then re-run this "
          "step: {}".format(url))
    return 1


def _setup_tailnet_android_online():
    """True if this machine's tailnet shows an Android device online."""
    try:
        r = _setup_spawn(["tailscale", "status", "--json"], timeout=15)
        peers = json.loads(r.stdout or "{}").get("Peer") or {}
    except Exception:
        return None
    return any((p.get("OS") or "").lower() == "android" and p.get("Online")
               for p in peers.values())


def _check_tailscale_phone():
    # The phone is reachable over adb only via Tailscale (or LAN).
    st = _setup_device_state()
    if st == "device":
        return True
    # Before pairing: if the tailnet already shows an Android phone online,
    # Tailscale is done on it and the user can skip this step.
    if _setup_tailnet_android_online():
        return True
    return None


def _check_tailscale_battery():
    out = _setup_sh("dumpsys", "deviceidle", "whitelist")
    if out is None:
        return None
    return SETUP_VPN_APP in out


def _run_tailscale_battery(args):
    # Same as Settings > Apps > Tailscale > App battery usage > Unrestricted.
    adb("shell", "dumpsys", "deviceidle", "whitelist", "+" + SETUP_VPN_APP,
        timeout=15)
    adb("shell", "cmd", "appops", "set", SETUP_VPN_APP,
        "RUN_ANY_IN_BACKGROUND", "allow", timeout=15)
    if not _check_tailscale_battery():
        print("could not set Tailscale battery usage to Unrestricted.",
              file=sys.stderr)
        return 1
    print("Tailscale battery usage set to Unrestricted, so Android won't "
          "stop it.")
    return 0


def _check_dev_options():
    v = _setup_get_setting("global", "development_settings_enabled")
    if v is None:
        return None
    return v == "1"


def _check_wireless_debug():
    v = _setup_get_setting("global", "adb_wifi_enabled")
    if v is None:
        return None
    return v == "1"


def _check_pair():
    return _setup_device_state() == "device"


def _check_install_app():
    out = _setup_sh("pm", "list", "packages", SETUP_APK_PKG)
    if out is None:
        return None
    return "package:{}".format(SETUP_APK_PKG) in out


def _check_self_pair():
    st = _setup_app_status()
    if st is None:
        return None
    return bool(st.get("isPaired"))


def _check_always_on_vpn():
    v = _setup_get_setting("secure", "always_on_vpn_app")
    if v is None:
        return None
    return v == SETUP_VPN_APP


def _check_fix_port():
    if CFG.get("ADB_PORT") != "5555":
        return False
    port = _setup_sh("getprop", "service.adb.tcp.port")
    if port is None:
        return None
    return port == "5555"


def _check_verify():
    return None  # run it to find out


# --- step run functions (agent steps) ---

def _run_prereqs(args):
    ok = True
    r = _setup_spawn([ADB_BIN, "version"], timeout=10)
    if r.returncode != 0:
        print("adb binary missing or broken. Run ./install.sh first.")
        return 1
    print("adb: {}".format((r.stdout or "").strip().splitlines()[0]))
    cfg_path = os.path.join(ROOT, "config.env")
    if not os.path.exists(cfg_path):
        ex = os.path.join(ROOT, "config.env.example")
        if os.path.exists(ex):
            with open(ex) as f:
                content = f.read()
            with open(cfg_path, "w") as f:
                f.write(content)
            print("created config.env from example; fill in PHONE_TAILSCALE_IP.")
        else:
            print("config.env missing and no example found.")
            ok = False
    else:
        print("config.env present.")
    return 0 if ok else 1


def _run_pair(args):
    if not args.code or not args.ip or not args.pair_port:
        print("pair needs --code, --ip and --pair-port from the phone's "
              "pairing dialog (it expires in about a minute).", file=sys.stderr)
        return 1
    code = args.code.strip()
    if not re.fullmatch(r"\d{6}", code):
        print("pair: code must be 6 digits.", file=sys.stderr)
        return 1
    pair_local = 15556
    proxy_host = os.environ.get("HTTPS_PROXY", "")
    proxy_host = proxy_host.split("://")[-1]
    proxy_auth = proxy_host.split("@")[0] if "@" in proxy_host else ""
    proxy_host = proxy_host.split("@")[-1].split(":")[0]
    socat_cmd = ["socat",
                 "TCP-LISTEN:{},bind=127.0.0.1,reuseaddr".format(pair_local),
                 "PROXY:{}:{}:{},proxyport=3130,proxyauth={}".format(
                     proxy_host, args.ip, args.pair_port, proxy_auth)]
    socat = _setup_popen(socat_cmd)
    time.sleep(1)
    try:
        r = _setup_spawn([ADB_BIN, "pair", "127.0.0.1:{}".format(pair_local)],
                         input_text=code + "\n", timeout=30)
        paired = r.returncode == 0
    finally:
        socat.terminate()
    if not paired:
        print("pairing failed. The code probably expired; get a fresh one "
              "from the phone and retry.", file=sys.stderr)
        return 1
    print("paired.")
    connect_port = args.connect_port or CFG.get("ADB_PORT", "5555")
    updates = {"PHONE_TAILSCALE_IP": args.ip, "ADB_PORT": str(connect_port)}
    _setup_write_config(updates)
    print("wrote PHONE_TAILSCALE_IP and ADB_PORT to config.env.")
    _setup_spawn([os.path.join(ROOT, "tunnel.sh"), "start"], timeout=45)
    r = adb("connect", TARGET, timeout=20)
    time.sleep(1)
    if _setup_device_state() == "device":
        print("connected: {}".format(TARGET))
        return 0
    print("paired but connect failed. Output: {}".format(
        ((r.stdout or "") + " " + (r.stderr or "")).strip()[:120]),
        file=sys.stderr)
    return 1


def _setup_find_apk():
    """Locate an adb-auto-enable APK locally or download v0.3.5. Returns path."""
    candidates = []
    for base in (WORKSPACE, os.path.expanduser("~/.cache/burner"),
                 os.path.expanduser("~/workspace")):
        try:
            for f in os.listdir(base):
                if f.endswith(".apk") and "adb" in f.lower():
                    candidates.append(os.path.join(base, f))
        except OSError:
            pass
    if candidates:
        return candidates[0]
    api = ("https://api.github.com/repos/mouldybread/adb-auto-enable"
           "/releases/tags/{}".format(SETUP_APK_VERSION))
    try:
        data = json.loads(_setup_urlopen(api).decode("utf-8"))
    except Exception as e:
        print("could not list GitHub releases: {}".format(e), file=sys.stderr)
        return None
    asset_url = None
    for a in data.get("assets", []):
        if a.get("name", "").endswith(".apk"):
            asset_url = a.get("browser_download_url")
            break
    if not asset_url:
        print("no APK asset in release {}.".format(SETUP_APK_VERSION),
              file=sys.stderr)
        return None
    dest = os.path.join(SETUP_APK_CACHE,
                        "adb-auto-enable-{}.apk".format(SETUP_APK_VERSION))
    print("downloading adb-auto-enable {} ...".format(SETUP_APK_VERSION))
    try:
        blob = _setup_urlopen(asset_url, timeout=120)
    except Exception as e:
        print("download failed: {}".format(e), file=sys.stderr)
        return None
    os.makedirs(SETUP_APK_CACHE, exist_ok=True)
    with open(dest, "wb") as f:
        f.write(blob)
    return dest


def _run_install_app(args):
    apk = _setup_find_apk()
    if not apk:
        return 1
    print("installing {} ...".format(os.path.basename(apk)))
    r = adb("install", "-r", apk, timeout=120)
    if r.returncode != 0:
        print("install failed: {}".format(
            ((r.stderr or "") + " " + (r.stdout or "")).strip()[:200]),
            file=sys.stderr)
        return 1
    r = adb("shell", "pm", "grant", SETUP_APK_PKG,
            "android.permission.WRITE_SECURE_SETTINGS", timeout=15)
    if r.returncode != 0:
        print("WRITE_SECURE_SETTINGS grant failed; do it manually on the phone.",
              file=sys.stderr)
        return 1
    r = adb("shell", "dumpsys", "deviceidle", "whitelist",
            "+" + SETUP_APK_PKG, timeout=15)
    if r.returncode != 0:
        print("warning: deviceidle whitelist failed (non-fatal).",
              file=sys.stderr)
    print("installed, granted WRITE_SECURE_SETTINGS, whitelisted.")
    return 0


SETUP_APP_API_PORT = "9093"     # adb-auto-enable's local web API
SETUP_APP_FWD_PORT = "19093"    # where we forward it on this machine


def _setup_app_api(path, body=None, timeout=60):
    """Call adb-auto-enable's local API through adb forward. Dict or None."""
    r = adb("forward", "tcp:" + SETUP_APP_FWD_PORT,
            "tcp:" + SETUP_APP_API_PORT, timeout=15)
    if r.returncode != 0:
        return None
    import urllib.request
    url = "http://127.0.0.1:{}{}".format(SETUP_APP_FWD_PORT, path)
    data = body.encode() if body is not None else None
    req = urllib.request.Request(url, data=data)
    if data is not None:
        req.add_header("Content-Type", "application/x-www-form-urlencoded")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        # Error responses carry a JSON body too.
        try:
            return json.loads(e.read().decode("utf-8"))
        except Exception:
            return None


def _setup_app_status():
    return _setup_app_api("/api/status", timeout=15)


def _setup_tap_label(label, scrolls=12):
    """Tap the node labelled exactly `label`, scrolling down to find it."""
    for _ in range(scrolls):
        hits = find_nodes(walk(ui_dump()), label)
        if hits:
            x, y = clickable_target(hits[0])
            tap_center(x, y)
            time.sleep(1.5)
            return True
        w, h = screen_dims()
        adb("shell", "input", "swipe", w // 2, h * 3 // 4, w // 2, h // 4, 300)
        time.sleep(0.8)
    return False


def _setup_read_pair_dialog():
    """Read (code, port) off the open pairing dialog. Never logged or stored."""
    code = port = None
    for n in walk(ui_dump()):
        t = (n["text"] or "").strip()
        if re.fullmatch(r"\d{6}", t):
            code = t
        m = re.fullmatch(r"[0-9a-fA-F.:\[\]]+:(\d{2,5})", t)
        if m:
            port = m.group(1)
    return code, port


def _run_self_pair(args):
    """Do adb-auto-enable's one-time self-pairing for the human, over adb.

    Opens the app once (starts its service and local API), opens Settings >
    Developer options > Wireless debugging > Pair device with pairing code
    on the phone, reads the code and port off the screen, and hands them to
    the app's /api/pair. The app then pairs with the phone over localhost."""
    if _check_self_pair():
        print("ADB Auto Enable is already paired.")
        return 0
    print("the phone will open ADB Auto Enable and Settings by itself for a "
          "few seconds; nothing to tap.")
    adb("shell", "monkey", "-p", SETUP_APK_PKG, "-c",
        "android.intent.category.LAUNCHER", "1", timeout=20)
    time.sleep(3)
    if _setup_app_status() is None:
        # Optional step: burner already works. Don't fail setup over it.
        print("skipped: ADB Auto Enable's built-in pairing page did not come "
              "up on the phone, so it can't be paired. burner still works. "
              "Without it, after the phone restarts the user turns Wireless "
              "debugging back on once and sends a screenshot of that screen. "
              "There's nothing for the user to fix.")
        return 0
    adb("shell", "am", "start", "-a",
        "android.settings.APPLICATION_DEVELOPMENT_SETTINGS", timeout=15)
    time.sleep(2)
    for label in ("Wireless debugging", "Pair device with pairing code"):
        if not _setup_tap_label(label):
            print("could not find '{}' on the phone screen.".format(label),
                  file=sys.stderr)
            return 1
    code, port = _setup_read_pair_dialog()
    if not code or not port:
        print("could not read the pairing code and port off the phone "
              "screen.", file=sys.stderr)
        return 1
    res = _setup_app_api("/api/pair", "port={}&code={}".format(port, code))
    for _ in range(3):
        adb("shell", "input", "keyevent", "KEYCODE_BACK", timeout=10)
        time.sleep(0.5)
    if not res or not res.get("success"):
        print("ADB Auto Enable pairing failed: {}".format(
            (res or {}).get("error", "no response")), file=sys.stderr)
        return 1
    time.sleep(2)
    print("ADB Auto Enable is paired and will keep ADB on after reboots.")
    return 0


def _check_stay_awake():
    v = _setup_get_setting("global", "stay_on_while_plugged_in")
    if v is None:
        return None
    return v == "7"


def _run_stay_awake(args):
    # 7 = stay on while charging from AC, USB or wireless.
    r = adb("shell", "settings", "put", "global", "stay_on_while_plugged_in",
            "7", timeout=15)
    if r.returncode != 0 or not _check_stay_awake():
        print("could not turn on Stay awake while charging.", file=sys.stderr)
        return 1
    print("screen now stays on while the phone is charging.")
    return 0


def _setup_has_secure_lock():
    """True if a PIN, pattern or password is set, None if we can't tell."""
    out = _setup_sh("locksettings", "verify")
    if out is None:
        return None
    return "verified successfully" not in out


def _check_screen_lock():
    secure = _setup_has_secure_lock()
    if secure is None:
        return None
    if secure:
        return False
    return _setup_sh("locksettings", "get-disabled") == "true"


def _run_screen_lock(args):
    secure = _setup_has_secure_lock()
    if secure:
        print("the phone has a PIN, pattern or password, so it locks after a "
              "restart and burner can't get in. Ask the user to remove it "
              "(it needs their PIN, so only they can): Settings > Security & "
              "privacy > Device unlock > Screen lock > enter PIN > None (on "
              "Samsung: Settings > Lock screen > Screen lock type > None). "
              "Then re-run this step.", file=sys.stderr)
        return 1
    r = adb("shell", "locksettings", "set-disabled", "true", timeout=15)
    if r.returncode != 0 or not _check_screen_lock():
        print("could not turn off the swipe lock screen.", file=sys.stderr)
        return 1
    print("lock screen off: the phone opens straight to the home screen.")
    return 0


def _run_always_on_vpn(args):
    lock = _setup_get_setting("secure", "always_on_vpn_lockdown")
    if lock == "1":
        print("always-on VPN lockdown is ON (Block connections without VPN). "
              "Turn it off on the phone first: Settings > Network > VPN > "
              "Tailscale gear > uncheck it. I will not change it for you.",
              file=sys.stderr)
        return 1
    r = adb("shell", "settings", "put", "secure", "always_on_vpn_app",
            SETUP_VPN_APP, timeout=15)
    if r.returncode != 0:
        print("settings put failed.", file=sys.stderr)
        return 1
    v = _setup_get_setting("secure", "always_on_vpn_app")
    if v != SETUP_VPN_APP:
        print("verify failed: always_on_vpn_app is {!r}.".format(v),
              file=sys.stderr)
        return 1
    print("Always-on VPN set to Tailscale (lockdown off). "
          "Tailscale now starts itself after reboot.")
    return 0


def _run_fix_port(args):
    r = adb("shell", "setprop", "service.adb.tcp.port", "5555", timeout=15)
    if r.returncode != 0:
        print("setprop failed.", file=sys.stderr)
        return 1
    _setup_write_config({"ADB_PORT": "5555"})
    _setup_spawn([os.path.join(ROOT, "tunnel.sh"), "start"], timeout=45)
    r = adb("connect", TARGET, timeout=20)
    time.sleep(2)
    port = _setup_sh("getprop", "service.adb.tcp.port")
    if _setup_device_state() == "device" and port == "5555":
        print("adbd is on fixed port 5555. config.env updated.")
        return 0
    print("port switch did not stick (adbd port: {}). The adb-auto-enable "
          "app's self-pairing (step self-pair) is what pins it; make sure "
          "that step is done, then re-run.".format(port), file=sys.stderr)
    return 1


def _run_verify(args):
    rc = cmd_doctor(argparse.Namespace(json=False))
    if rc == 0:
        print("setup GREEN: phone is reachable and healthy.")
    else:
        print("setup RED: doctor found problems (see above).", file=sys.stderr)
    return rc


