# burner config. Copy to config.env and fill in YOUR values.
# install.sh does this copy for you (it never overwrites an existing config.env).
# config.env is gitignored: it holds your local endpoints, never commit it.

# A short name for the phone. Used in logs and status output.
PHONE_NAME="your-phone-name"

# The phone's Tailscale IP (Tailscale app on the phone > this device's address),
# or its LAN IP if the VM and phone share a network. Example: 100.100.12.34
PHONE_TAILSCALE_IP="YOUR_PHONE_TAILSCALE_IP"

# Wireless debugging CONNECTION port, shown on the phone under
# Developer options > Wireless debugging as IP:port.
# This is NOT the pairing port. Android assigns a random port; it changes if
# wireless debugging is toggled off and on, so update this if the phone goes
# unreachable after a toggle.
ADB_PORT="YOUR_ADB_CONNECTION_PORT"

# Local port the tunnel listens on; adb connects to this. Any free high port.
LOCAL_PORT="15555"

# Optional: package name of an app you launch often, for quick recipes.
AMAZON_PKG="com.amazon.mShop.android.shopping"

# Optional: Gmail CLI used by `pc gcode` / `pc vcode` to pull verification
# codes. Must support: <cmd> gmail +triage --query Q --max N --format json
# and <cmd> gmail +read --id ID --format json (both emitting JSON).
# Leave unset if you don't use the code-pull shortcuts.
#GMAIL_CLI="your-gmail-cli"
